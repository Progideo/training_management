msgstr "À revoir"

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid ""
"Not saved. Check your connection. Reload to recover only answers already "
"received by the server."
msgstr ""
"Non sauvegardé. Vérifiez votre connexion. Rechargez pour retrouver "
"uniquement les réponses déjà reçues par le serveur."

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Not saved. Reload to recover answers already received by the server."
msgstr ""
"Non sauvegardé. Rechargez pour retrouver les réponses déjà reçues par le "
"serveur."

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Question %s"
msgstr "Question %s"

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Saved on the server."
msgstr "Sauvegardé sur le serveur."

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Saving…"
msgstr "Sauvegarde en cours…"

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid ""
"Submission blocked: some answers are not saved. Reload and verify your saved"
" answers."
msgstr ""
"Remise bloquée : certaines réponses ne sont pas sauvegardées. Rechargez et "
"vérifiez vos réponses sauvegardées."

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Submission not confirmed. Check your connection and retry."
msgstr "Remise non confirmée. Vérifiez votre connexion et réessayez."

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid ""
"Time elapsed. Only answers received before the server deadline are retained."
" Reconnect to see the result."
msgstr ""
"Temps écoulé. Seules les réponses reçues avant l’échéance du serveur sont "
"conservées. Reconnectez-vous pour consulter le résultat."

#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Unanswered"
msgstr "Sans réponse"

#. module: training_mock_exam
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid ""
"%s question(s) not confirmed on the server. Check your connection, then "
"retry saving. Keep this page open."
msgstr ""
"%s question(s) non confirmée(s) sur le serveur. Vérifiez votre connexion, "
"puis réessayez la sauvegarde. Gardez cette page ouverte."

#. module: training_mock_exam
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Before submitting, retry saving the unconfirmed answers."
msgstr ""
"Avant de remettre la tentative, réessayez la sauvegarde des réponses non "
"confirmées."

#. module: training_mock_exam
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Changes not yet confirmed on the server"
msgstr "Modifications pas encore confirmées sur le serveur"

#. module: training_mock_exam
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Saving %s question(s)…"
msgstr "Sauvegarde de %s question(s)…"


