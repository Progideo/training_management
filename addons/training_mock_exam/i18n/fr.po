#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "An authorized learner context is required."
msgstr "Un contexte apprenant autorisé est requis."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "No published mock exam is assigned."
msgstr "Aucun examen blanc publié n’est affecté."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "This exam belongs to another company."
msgstr "Cet examen appartient à une autre société."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "Choose answers from this question."
msgstr "Choisissez des réponses appartenant à cette question."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "Choose one answer for a QCU question."
msgstr "Choisissez une seule réponse pour une question à choix unique."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "Correction is available only after submission."
msgstr "Le corrigé est disponible uniquement après la remise."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "Unclassified"
msgstr "Sans thème"

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "Assign each item at most once; leave unanswered rows empty."
msgstr "Attribuez chaque élément une seule fois ; laissez vides les lignes sans réponse."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/attempt.py:0
msgid "Keep the exam history."
msgstr "Conservez l’historique des examens."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/attempt.py:0
msgid "Use the checked exam operations; completed answers are immutable."
msgstr "Utilisez les opérations contrôlées ; les réponses terminées sont immuables."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/boundary.py:0
msgid "Learner evidence requires an authorized context."
msgstr "Un contexte autorisé est requis pour consulter les preuves d’un apprenant."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/boundary.py:0
msgid "Use an authorized learner context for this mock exam."
msgstr "Utilisez un contexte apprenant autorisé pour cet examen blanc."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/boundary.py:0
msgid "Exam evidence is generated by the server."
msgstr "Les preuves d’examen sont produites par le serveur."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/boundary.py:0
msgid "Keep native answer identities unchanged."
msgstr "Conservez les identifiants des réponses natives."

#. module: training_mock_exam
#. odoo-python
#: code:addons/training_mock_exam/models/service.py:0
msgid "Choose a valid exam obligation."
msgstr "Choisissez une obligation d’examen valide."


#. module: training_mock_exam
#. odoo-python
#. odoo-javascript
#: code:addons/training_mock_exam/static/src/exam.js:0
msgid "Answered"
msgstr "Répondu"

