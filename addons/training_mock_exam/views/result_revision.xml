<odoo>
    <record id="revise_form" model="ir.ui.view">
        <field name="name">training.exam.revise.form</field>
        <field name="model">training.exam.revise</field>
        <field name="arch" type="xml">
            <form string="Motivated Result Revision">
                <group>
                    <field name="attempt_id" readonly="1"/>
                    <field name="request_key" invisible="1"/>
                    <field name="expected_previous" invisible="1"/>
                    <field name="reason"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="question_id" readonly="1" force_save="1"/>
                        <field name="previous_points" readonly="1" force_save="1"/>
                        <field name="maximum" readonly="1" force_save="1"/>
                        <field name="points"/>
                    </list>
                </field>
                <footer><button name="action_apply" type="object" string="Record Revision" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
