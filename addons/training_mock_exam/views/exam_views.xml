<odoo>
    <record id="exam_form" model="ir.ui.view"><field name="name">survey.survey.shared.mock</field><field name="model">survey.survey</field><field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_mock_publish" type="object" string="Publier l’examen" groups="training_mock_exam.group_mock_exam_author" invisible="not training_course_id or training_state != 'draft'"/><button name="action_mock_new_version" type="object" string="Nouvelle version" groups="training_mock_exam.group_mock_exam_author" invisible="not training_course_id or training_state != 'published'"/></xpath>
            <xpath expr="//sheet//field[not(ancestor::field)]" position="attributes"><attribute name="readonly" add="training_course_id and training_state == 'published'" separator=" or "/></xpath>
            <xpath expr="//sheet" position="inside"><field name="training_course_id" invisible="1"/><field name="training_state" invisible="1"/><group string="Bibliothèque d’examens blancs" groups="training_mock_exam.group_mock_exam_author" invisible="not training_course_id and not context.get('mock_exam_editor')"><field name="training_course_id" readonly="id" required="context.get('mock_exam_editor')"/><field name="training_state" readonly="1"/><field name="training_origin_id" context="{'form_view_ref': 'survey.survey_survey_view_form'}" readonly="1"/><field name="training_version" readonly="training_state == 'published'"/><field name="training_revision_reason" readonly="training_state == 'published'"/></group></xpath>
        </field>
    </record>
    <record id="question_form" model="ir.ui.view"><field name="name">survey.question.shared.mock</field><field name="model">survey.question</field><field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="inside"><field name="training_course_id" invisible="1"/><group string="Examen blanc" invisible="not training_course_id" groups="training_mock_exam.group_mock_exam_author"><field name="answer_score"/><field name="training_theme"/><field name="training_explanation"/></group></xpath></field>
    </record>
    <record id="exam_action" model="ir.actions.act_window"><field name="name">Examens blancs partagés</field><field name="res_model">survey.survey</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('survey.survey_survey_view_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('survey.survey_survey_view_form')})]"/><field name="domain">[('training_course_id', '!=', False)]</field><field name="context">{'mock_exam_editor': True}</field></record>
    <menuitem id="exam_menu" name="Examens blancs partagés" parent="training_catalog.menu_catalog_root" action="exam_action" groups="training_mock_exam.group_mock_exam_author" sequence="80"/>
 <record id="question_configure_form" model="ir.ui.view"><field name="name">elearning.question.configure.form</field><field name="model">training.elearning.question.configure</field><field name="arch" type="xml"><form string="Configurer une interaction"><group><field name="question_id"/><field name="kind"/><field name="items" placeholder="Appariement : gauche | droite, une paire par ligne.&#10;Mise en ordre : une ligne par élément, dans l’ordre correct."/></group><p>Deux à huit éléments distincts. Réponse exacte complète : tous les points ; réponse partielle, incorrecte ou vide : zéro.</p><footer><button name="action_configure" type="object" string="Configurer la question" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="question_configure_action" model="ir.actions.act_window"><field name="name">Configurer une interaction</field><field name="res_model">training.elearning.question.configure</field><field name="view_mode">form</field><field name="target">new</field></record>
 <record id="question_enriched_form" model="ir.ui.view"><field name="name">survey.question.shared.enriched</field><field name="model">survey.question</field><field name="inherit_id" ref="survey.survey_question_form"/><field name="arch" type="xml">
  <xpath expr="//field[@name='question_type']" position="after"><field name="training_interaction" readonly="1" invisible="not training_course_id"/><button name="%(question_configure_action)d" type="action" string="Configurer appariement / ordre" context="{'default_question_id': id}" groups="training_mock_exam.group_mock_exam_author" invisible="not training_course_id or not id"/></xpath>
  <xpath expr="//field[@name='suggested_answer_ids']" position="before"><field name="training_interaction_solution" string="Solution attendue" invisible="not training_course_id or not training_interaction" groups="training_mock_exam.group_mock_exam_author"/></xpath>
 </field></record>
</odoo>
