<odoo>
  <template id="exam_choice_image" inherit_id="survey.question_suggested_value_image" primary="True" name="Authorized Native Choice Image">
    <xpath expr="//div[@t-if]" position="attributes">
      <attribute name="t-if">True</attribute>
    </xpath>
    <xpath expr="//div[@t-else]" position="replace">
      <t />
    </xpath>
    <xpath expr="//img" position="attributes">
      <attribute name="t-att-src">image_url(question.id, label.id)</attribute>
    </xpath>
  </template>
  <template id="exam_simple_choice" inherit_id="survey.question_simple_choice" primary="True" name="Private Native Single Choice">
    <xpath expr="//t[@t-call='survey.question_suggested_value_image']" position="attributes">
      <attribute name="t-call">training_mock_exam.exam_choice_image</attribute>
    </xpath>
    <xpath expr="//span[@t-field='label.value']" position="attributes">
      <attribute name="t-field">label.value_label</attribute>
    </xpath>
  </template>
  <template id="exam_multiple_choice" inherit_id="survey.question_multiple_choice" primary="True" name="Private Native Multiple Choice">
    <xpath expr="//t[@t-set='answer_class']" position="attributes">
      <attribute name="t-value">''</attribute>
    </xpath>
    <xpath expr="//t[@t-call='survey.question_suggested_value_image']" position="attributes">
      <attribute name="t-call">training_mock_exam.exam_choice_image</attribute>
    </xpath>
    <xpath expr="//span[@t-field='label.value']" position="attributes">
      <attribute name="t-field">label.value_label</attribute>
    </xpath>
  </template>
  <template id="exam_attempt" name="Private Mock Exam">
    <t t-call="survey.layout" additional_title.translate="Mock exam">
      <div class="container py-4 o_not_editable">
        <a t-att-href="back">My attempts / retake the mock exam</a>
        <h1 t-out="survey.title" />
        <p>Mock exam — no official certification.</p>
        <t t-if="result">
          <form t-if="can_retake" t-att-action="back" method="post" class="my-3">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
            <p>Retaking starts a new attempt with the full duration. Previous results are preserved.</p>
            <button type="submit" class="btn btn-primary">Confirm and retake the mock exam</button>
          </form>
          <t t-call="training_mock_exam.exam_result" />
        </t>
        <t t-else="">
          <div class="o_training_exam" t-att-data-endpoint="save_url">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
            <div class="o_survey_form_content_data d-none" t-att-data-server-time="server_time" t-att-data-timer="answer.start_datetime.isoformat()" t-att-data-time-limit-minutes="survey.time_limit" />
            <p class="o_survey_timer_container">Time remaining: <strong class="o_survey_timer" role="timer" />
            </p>
            <p class="tm_save_status alert alert-info" role="status" aria-live="polite">Answers received by the server are saved. Unsaved changes will be reported here.</p>
            <button type="button" class="tm_retry btn btn-warning mb-3" hidden="hidden">Retry saving / check the result</button>
            <nav aria-label="Question palette" class="d-flex flex-wrap gap-2 mb-3">
              <button t-foreach="answer.predefined_question_ids.sorted(lambda q: (q.sequence, q.id))" t-as="question" type="button" class="btn btn-outline-secondary tm_question_link" t-att-data-question="question.id">
                <t t-out="question_index + 1" />
                <span class="tm_question_state" />
              </button>
            </nav>
            <fieldset t-foreach="answer.predefined_question_ids.sorted(lambda q: (q.sequence, q.id))" t-as="question" class="tm_question border p-3 mb-3" t-att-data-question="question.id">
              <legend class="h5" tabindex="-1">
                <span t-out="question_index + 1" />. <t t-out="question.title" />
              </legend>
              <div t-field="question.description" />
              <t t-set="answer_lines" t-value="answer.user_input_line_ids.filtered(lambda line: line.question_id == question)" />
              <t t-if="question.question_type == 'simple_choice'" t-call="training_mock_exam.exam_simple_choice" />
              <t t-else="">
                <t t-if="question.training_interaction" t-call="training_mock_exam.enriched_question" />
                <t t-else="" t-call="training_mock_exam.exam_multiple_choice" />
              </t>
              <label class="mt-3 d-block">
                <input type="checkbox" class="tm_review form-check-input me-2" t-att-checked="question in answer.training_review_ids" />Mark for review</label>
              <button type="button" class="tm_clear btn btn-link">Clear answer</button>
              <p class="tm_question_save_state small" role="status" />
            </fieldset>
            <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 my-3">
              <button type="button" class="tm_previous btn btn-outline-secondary">Previous</button>
              <button type="button" class="tm_next btn btn-outline-secondary">Next</button>
              <button type="button" class="tm_summary btn btn-secondary">Review and submit</button>
            </div>
            <div class="tm_recap card p-3" hidden="hidden">
              <h2>Submission summary</h2>
              <p class="tm_recap_text" />
              <p>Submitting ends this attempt. Its answers cannot then be changed.</p>
              <button type="button" class="tm_submit btn btn-primary">Confirm final submission</button>
            </div>
            <noscript>
              <p class="alert alert-warning">JavaScript is required for answer saving and navigation. This attempt remains timed; reload after enabling JavaScript.</p>
            </noscript>
          </div>
        </t>
      </div>
    </t>
  </template>
  <template id="exam_result" name="Mock Exam Correction and Themes">
    <h2>Result and final correction</h2>
    <p>
      <strong t-out="result['points']" /> / <span t-out="result['maximum']" /> — <strong t-out="round(result['percentage'], 2)" /> % · <t t-if="result['success']">Threshold reached</t>
      <t t-else="">Threshold not reached</t>
    </p>
    <p>This mock exam result does not guarantee success in an official exam.</p>
    <t t-if="result['revisions']">
      <p>Initial result preserved: <t t-out="round(result['original_percentage'], 2)" /> %.</p>
      <ul>
        <li t-foreach="result['revisions']" t-as="revision">
          <span t-out="revision['date']" />: <t t-out="revision['reason']" />
        </li>
      </ul>
    </t>
    <h3>Results by theme</h3>
    <div class="table-responsive" role="region" aria-label="Results by theme" tabindex="0">
      <table class="table">
        <thead>
          <tr>
            <th>Theme</th>
            <th>Points</th>
            <th>Score</th>
          </tr>
        </thead>
        <tbody>
          <tr t-foreach="result['themes'].items()" t-as="theme">
            <th t-out="theme[0]" />
            <td>
              <span t-out="theme[1]['points']" /> / <span t-out="theme[1]['maximum']" />
            </td>
            <td>
              <t t-if="theme[1]['maximum']">
                <span t-out="round(100 * theme[1]['points'] / theme[1]['maximum'], 2)" /> %</t>
              <t t-else="">Not evaluated</t>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <section t-foreach="result['questions']" t-as="q" class="card p-3 my-3">
      <h3 class="h5" t-out="q['title']" />
      <p>Your answers: <span t-out="', '.join(q['selected']) or '—'" />
      </p>
      <p>Expected answers: <span t-out="', '.join(q['correct'])" />
      </p>
      <p>
        <span t-out="q['points']" /> / <span t-out="q['maximum']" />
      </p>
      <figure t-foreach="q['images']" t-as="image">
        <img t-att-src="image['url']" t-att-alt="image['label']" class="img-fluid" />
        <figcaption t-out="image['label']" />
      </figure>
      <p t-if="q['explanation']" t-out="q['explanation']" />
      <a t-if="q['url']" t-att-href="q['url']">Authorized revision resource</a>
    </section>
  </template>
  <template id="enriched_question" name="Matching or ordering question">
    <div class="tm_enriched" t-att-data-kind="question.training_interaction">
      <p t-if="question.training_interaction == 'matching'">Associez chaque élément à une seule proposition. Chaque proposition doit être utilisée une seule fois.</p>
      <p t-else="">Choisissez l’élément qui correspond à chaque position. Chaque élément doit être utilisé une seule fois.</p>
      <t t-foreach="question._interaction_rows()" t-as="row">
        <div class="mb-3">
          <label class="form-label" t-att-for="'enriched-%s-%s' % (question.id, row['key'])" t-out="row['label']" />
          <select disabled="disabled" class="form-select tm_enriched_select" t-att-id="'enriched-%s-%s' % (question.id, row['key'])" t-att-data-row="row['key']">
            <option value="">— Sans réponse —</option>
            <option t-foreach="row['choices']" t-as="choice" t-att-value="choice['id']" t-att-data-option="choice['option']" t-att-selected="choice['id'] in answer_lines.suggested_answer_id.ids" t-out="choice['label']" />
          </select>
          <input t-foreach="row['choices']" t-as="choice" type="checkbox" class="o_survey_form_choice_item tm_enriched_value" hidden="hidden" tabindex="-1" aria-hidden="true" t-att-data-row="row['key']" t-att-value="choice['id']" t-att-checked="choice['id'] in answer_lines.suggested_answer_id.ids" />
        </div>
      </t>
    </div>
  </template>
</odoo>
