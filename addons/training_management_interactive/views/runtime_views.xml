<odoo>
 <template id="portal_interactive_activity" inherit_id="training_management.portal_learning_content" name="Interactive formative activity">
  <xpath expr="//h3[@t-out=&quot;a['name']&quot;]" position="after">
   <p t-if="not is_tutor and a.get('interactive_url')"><a class="btn btn-primary" t-att-href="a['interactive_url']">Ouvrir l’activité interactive</a></p>
   <p t-if="a.get('interactive_withdrawn')" class="alert alert-warning">Contenu retiré pour sécurité. Contactez la coordination.</p>
  </xpath>
 </template>
 <record id="attempt_list" model="ir.ui.view"><field name="name">elearning.attempt.list</field><field name="model">training.elearning.attempt</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="enrollment_id"/><field name="usage_id"/><field name="version_id"/><field name="number"/><field name="revision"/><field name="score"/><field name="maximum"/><field name="completed"/><field name="last_saved_at"/></list></field></record>
 <record id="attempt_form" model="ir.ui.view"><field name="name">elearning.attempt.form</field><field name="model">training.elearning.attempt</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><div class="alert alert-info">Résultats formatifs émis par le contenu. La progression de référence reste celle de l’inscription TM.</div><group><field name="enrollment_id"/><field name="usage_id"/><field name="version_id"/><field name="number"/><field name="revision"/><field name="score"/><field name="maximum"/><field name="completed"/><field name="last_saved_at"/></group></sheet></form></field></record>
 <record id="attempt_action" model="ir.actions.act_window"><field name="name">Tentatives interactives</field><field name="res_model">training.elearning.attempt</field><field name="view_mode">list,form</field></record>
 <menuitem id="attempt_menu" name="Tentatives interactives" parent="training_management.menu_training_pedagogy" action="attempt_action" groups="training_management.group_training_coordinator" sequence="80"/>
 <record id="invalidate_form" model="ir.ui.view"><field name="name">elearning.invalidate.form</field><field name="model">training.elearning.invalidate</field><field name="arch" type="xml"><form string="Invalider un acquis formatif"><group><field name="progress_id" domain="[('elearning_completed','=',True)]"/><field name="reason"/></group><p>La trace d’origine est conservée. Une nouvelle tentative sera nécessaire pour acquérir à nouveau cette activité.</p><footer><button name="action_invalidate" type="object" string="Invalider avec ce motif" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="invalidate_action" model="ir.actions.act_window"><field name="name">Invalider un acquis formatif</field><field name="res_model">training.elearning.invalidate</field><field name="view_mode">form</field><field name="target">new</field></record>
 <menuitem id="invalidate_menu" name="Invalider un acquis formatif" parent="training_management.menu_training_pedagogy" action="invalidate_action" groups="training_management.group_training_coordinator" sequence="81"/>
 <template id="interactive_entry" name="Activité interactive">
  <t t-call="portal.portal_layout"><t t-call="training_management.portal_training_navigation"/>
   <main class="container py-4"><h1 t-out="title"/><p t-out="objective"/><p>Version <t t-out="version"/>.</p>
    <p t-if="acquired" class="alert alert-success">Acquisition formative conservée dans votre formation.</p><p t-else="">Activité à terminer dans votre formation.</p>
    <p t-if="threshold is not None">Complétion du contenu et score minimal : <t t-out="threshold"/> %.</p>
    <div class="d-flex flex-wrap gap-2 mb-4"><form t-att-action="start_url" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="request_key" t-att-value="request_key"/><button class="btn btn-primary"><t t-if="attempts">Reprendre la tentative</t><t t-else="">Commencer</t></button></form>
    <form t-if="attempts" t-att-action="start_url" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="request_key" t-att-value="new_key"/><input type="hidden" name="new" value="1"/><button class="btn btn-outline-primary">Nouvelle tentative</button></form></div>
    <t t-if="attempts"><h2>Vos tentatives</h2><div class="table-responsive" role="region" aria-label="Historique des tentatives" tabindex="0"><table class="table"><thead><tr><th>Numéro</th><th>Dernière sauvegarde</th><th>Score formatif</th></tr></thead><tbody><tr t-foreach="attempts" t-as="a"><td t-out="a['number']"/><td t-out="a['saved']"/><td t-out="a['score']"/></tr></tbody></table></div></t>
    <p>Une nouvelle tentative démarre sans réponse. Une réussite déjà acquise reste conservée ; ces résultats formatifs ne délivrent aucune attestation.</p><a t-att-href="back">Revenir à ma formation</a>
   </main>
  </t>
 </template>
</odoo>
