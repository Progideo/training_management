<odoo>
 <record id="import_form" model="ir.ui.view"><field name="name">elearning.import.form</field><field name="model">training.elearning.import</field><field name="arch" type="xml"><form string="Importer un paquet"><group><field name="resource_id"/><field name="number"/><field name="filename" invisible="1"/><field name="data" filename="filename"/><field name="license_note"/><field name="provenance"/></group><footer><button name="action_import" type="object" string="Contrôler et importer" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="import_action" model="ir.actions.act_window"><field name="name">Importer une version</field><field name="res_model">training.elearning.import</field><field name="view_mode">form</field><field name="target">new</field></record>
 <record id="withdraw_form" model="ir.ui.view"><field name="name">elearning.withdraw.form</field><field name="model">training.elearning.withdraw</field><field name="arch" type="xml"><form string="Retrait de sécurité"><group><field name="version_id"/><field name="reason"/></group><footer><button name="action_withdraw" type="object" string="Bloquer les prochains accès" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="withdraw_action" model="ir.actions.act_window"><field name="name">Retrait de sécurité</field><field name="res_model">training.elearning.withdraw</field><field name="view_mode">form</field><field name="target">new</field></record>
 <record id="apply_form" model="ir.ui.view"><field name="name">elearning.apply.form</field><field name="model">training.elearning.apply</field><field name="arch" type="xml"><form string="Affecter aux réalisations"><group><field name="assignment_id"/><field name="delivery_ids" widget="many2many_tags"/></group><footer><button name="action_apply" type="object" string="Créer les activités" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="apply_action" model="ir.actions.act_window"><field name="name">Affecter aux réalisations</field><field name="res_model">training.elearning.apply</field><field name="view_mode">form</field><field name="target">new</field></record>
 <record id="version_list" model="ir.ui.view"><field name="name">elearning.version.list</field><field name="model">training.elearning.version</field><field name="arch" type="xml"><list create="0" delete="0"><field name="resource_id"/><field name="number"/><field name="state"/><field name="published_at"/></list></field></record>
 <record id="version_form" model="ir.ui.view"><field name="name">elearning.version.form</field><field name="priority">5</field><field name="model">training.elearning.version</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_preview" type="object" string="Prévisualiser" invisible="state == 'withdrawn'"/><button name="action_publish" type="object" string="Publier" groups="training_interactive.group_interactive_author" invisible="state != 'draft'"/><button name="%(withdraw_action)d" type="action" string="Retirer pour sécurité" context="{'default_version_id': id}" groups="training_interactive.group_interactive_manager" invisible="state == 'withdrawn'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="resource_id"/><field name="number"/><field name="sha256"/><field name="license_note"/><field name="provenance"/><field name="published_at"/><field name="published_by_id"/><field name="withdrawn_at" invisible="not withdrawn_at"/><field name="withdrawn_by_id" invisible="not withdrawn_by_id"/><field name="withdrawal_reason" invisible="not withdrawal_reason"/></group></sheet></form></field></record>
 <record id="resource_editorial" model="ir.ui.view"><field name="name">elearning.resource.editorial</field><field name="model">training.elearning.resource</field><field name="inherit_id" ref="resource_form"/><field name="arch" type="xml"><xpath expr="//form/sheet/div" position="replace"><div class="alert alert-info">Les paquets sont contrôlés à l’import. Prévisualisez la version isolée avant de la publier.</div></xpath><xpath expr="//form/sheet" position="before"><header><button name="%(import_action)d" type="action" string="Importer une version" context="{'default_resource_id': id}" invisible="not id or not active"/></header></xpath><xpath expr="//form/sheet" position="inside"><field name="version_ids" readonly="1"><list create="0" delete="0"><field name="number"/><field name="state"/><field name="published_at"/></list></field></xpath></field></record>
 <record id="assignment_form" model="ir.ui.view"><field name="name">elearning.assignment.form</field><field name="model">training.elearning.assignment</field><field name="arch" type="xml"><form><header><button name="action_validate" type="object" string="Valider la règle" invisible="state != 'draft'"/><button name="%(apply_action)d" type="action" string="Affecter aux réalisations" context="{'default_assignment_id': id}" invisible="state != 'validated'"/><field name="state" widget="statusbar"/></header><sheet><group readonly="state == 'validated'"><field name="name"/><field name="company_id" invisible="1"/><field name="program_id" domain="[('company_id', 'in', allowed_company_ids)]"/><field name="version_id" domain="[('state', '=', 'published'), ('company_id', '=', company_id)]"/><field name="objective"/><field name="rule"/><field name="threshold" invisible="rule != 'score'"/><field name="counts_for_completion" readonly="state != 'draft'"/></group><field name="usage_ids" readonly="1"><list><field name="activity_id"/><field name="delivery_id"/><field name="version_id"/></list></field></sheet></form></field></record>
 <record id="assignment_list" model="ir.ui.view"><field name="name">elearning.assignment.list</field><field name="model">training.elearning.assignment</field><field name="arch" type="xml"><list><field name="name"/><field name="program_id"/><field name="version_id"/><field name="rule"/><field name="threshold"/><field name="state"/></list></field></record>
 <record id="assignment_action" model="ir.actions.act_window"><field name="name">Affectations interactives</field><field name="res_model">training.elearning.assignment</field><field name="view_mode">list,form</field></record>
 <menuitem id="assignment_menu" name="Affectations interactives" parent="training_management.menu_training_catalogue" action="assignment_action" groups="training_management.group_training_coordinator" sequence="91"/>
</odoo>
