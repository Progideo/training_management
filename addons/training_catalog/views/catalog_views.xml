<odoo>
    <record id="view_training_course_list" model="ir.ui.view">
        <field name="name">training.course.list</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_training_course_form" model="ir.ui.view">
        <field name="name">training.course.form</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_public_page" type="object" string="Preview Public Page"
                            icon="fa-globe" groups="training_catalog.group_catalog_editor"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not active or not public_catalogue"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="public_catalogue"/>
                            <field name="public_published_at" readonly="1" invisible="not public_published_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Website" name="website">
                            <group string="General Presentation" name="website_presentation">
                                <field name="presentation" placeholder="First paragraph: tagline shown under the title"/>
                                <field name="general_objectives"/>
                                <field name="public_highlights" placeholder="One highlight per line"/>
                                <field name="public_logo" widget="image" class="oe_avatar"/>
                            </group>
                            <group string="Key Facts" name="website_facts">
                                <group>
                                    <field name="public_reference"/>
                                    <field name="live_duration_days"/>
                                </group>
                                <group>
                                    <field name="public_level"/>
                                    <field name="public_certifying"/>
                                    <field name="public_inter_offered"/>
                                </group>
                            </group>
                            <group string="Related Courses" name="website_related">
                                <field name="public_related_course_ids" nolabel="1" colspan="2" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Programme" name="website_programme">
                            <field name="public_programme"/>
                        </page>
                        <page string="Frequently Asked Questions" name="website_faq">
                            <field name="public_faq_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question"/>
                                    <field name="answer"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_training_course_search" model="ir.ui.view">
        <field name="name">training.course.search</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_training_courses" model="ir.actions.act_window">
        <field name="name">Formations</field>
        <field name="res_model">training.course</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_training_course_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_training_course_form')})
        ]"/>
    </record>


    <record id="view_training_category_list" model="ir.ui.view">
        <field name="name">training.category.list</field>
        <field name="model">training.category</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>
    <record id="view_training_category_form" model="ir.ui.view">
        <field name="name">training.category.form</field>
        <field name="model">training.category</field>
        <field name="arch" type="xml">
            <form><sheet>
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                <group><field name="active" invisible="1"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="action_training_categories" model="ir.actions.act_window">
        <field name="name">Training Categories</field><field name="res_model">training.category</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_catalog_root" name="Catalogue de formations" sequence="45" groups="training_catalog.group_catalog_reader"/>
    <menuitem id="menu_catalog_courses" name="Formations" parent="menu_catalog_root" action="action_training_courses"/>
    <menuitem id="menu_catalog_categories" name="Catégories" parent="menu_catalog_root" action="action_training_categories"/>
</odoo>
