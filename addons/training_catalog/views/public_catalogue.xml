<odoo>
  <template id="public_course_tags" name="Public catalogue tags">
    <ul t-if="tags" class="o_training_catalogue_tags list-unstyled d-flex flex-wrap gap-1 mb-2" role="list" aria-label="Étiquettes">
      <li t-foreach="tags" t-as="tag"
          t-attf-class="badge border text-wrap text-start #{'o_wslides_channel_tag o_color_%s' % tag['color'] if tag['color'] else 'text-bg-light'}"
          t-out="tag['label']"/>
    </ul>
  </template>
  <template id="public_catalogue_card" name="Public catalogue card">
    <article class="col">
      <div class="card h-100 rounded-0 border o_training_catalogue_card"><div class="card-body d-flex flex-column gap-2 position-relative text-break">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <span t-if="course['category']" class="small fw-bold text-uppercase text-primary o_training_catalogue_domain" t-out="course['category']"/>
          <span t-if="course.get('is_new')" class="badge text-bg-primary ms-auto">Nouveau</span>
        </div>
        <h2 class="h5 mb-0 o_training_catalogue_title"><a class="stretched-link text-decoration-none" t-att-href="'/formations/catalogue/%s' % course['id']" t-out="course['name']"/></h2>
        <p t-if="course['presentation']" class="mb-0 o_training_catalogue_summary" style="white-space:pre-wrap" t-out="course['presentation']"/>
        <div class="d-flex flex-wrap gap-1 small">
          <span t-if="course['duration_label']" class="border px-2 py-1"><t t-out="course['duration_label']"/> <t t-if="course['duration_plural']">jours</t><t t-else="">jour</t></span>
          <span t-if="course.get('level')" class="border px-2 py-1" t-out="course['level']"/>
          <span t-if="course.get('certifying')" class="border border-warning bg-warning-subtle px-2 py-1 fw-semibold">Certifiante</span>
          <span t-if="course.get('live')" class="border px-2 py-1 d-inline-flex align-items-center gap-1">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>Avec formateur</span>
          <span t-if="course['formats']['autonomous']" class="border px-2 py-1 d-inline-flex align-items-center gap-1">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M2 20h20"/></svg>eLearning</span>
        </div>
        <t t-call="training_catalog.public_course_tags" tags="course['tags']"/>
        <ul class="list-unstyled d-flex flex-wrap gap-1 small mb-0 o_training_catalogue_formats" aria-label="Formats disponibles">
          <li t-attf-class="px-2 py-1 #{'bg-body-tertiary fw-semibold' if course['formats']['inter'] else 'text-body-secondary text-decoration-line-through'}">Inter</li>
          <li t-attf-class="px-2 py-1 #{'bg-body-tertiary fw-semibold' if course['formats']['intra'] else 'text-body-secondary text-decoration-line-through'}">Intra</li>
          <li t-attf-class="px-2 py-1 #{'bg-body-tertiary fw-semibold' if course['formats']['autonomous'] else 'text-body-secondary text-decoration-line-through'}">Autonomie</li>
        </ul>
        <ul t-if="course['offers']" class="small mb-0 o_training_catalogue_offers">
          <li t-foreach="course['offers']" t-as="offer"><a class="position-relative z-2" t-att-href="offer['url']"><t t-out="offer['kind']"/> : <t t-out="offer['title']"/></a></li>
        </ul>
      </div>
      <div class="card-footer bg-body-tertiary d-flex justify-content-between align-items-end gap-2 small">
        <div>
          <span class="d-block text-body-secondary"><t t-if="course['next_label']">Prochaine session</t><t t-else="">Sessions</t></span>
          <strong t-if="course['next_label']" t-out="course['next_label']"/>
          <strong t-else="">Sur demande</strong>
        </div>
        <div class="text-end">
          <span class="d-block text-body-secondary"><t t-if="course['price_per_participant']">Par participant</t><t t-else="">Tarif</t></span>
          <strong t-if="course['price_label']"><t t-out="course['price_label']"/> HT</strong>
          <strong t-else="">Sur devis</strong>
        </div>
      </div></div>
    </article>
  </template>
  <template id="public_catalogue" name="General training catalogue">
    <t t-call="portal.frontend_layout" additional_title.translate="Formations">
      <div id="wrap" class="o_training_public_page o_training_catalogue o_not_editable">
        <section class="bg-primary text-white py-4 py-md-5">
          <div class="container">
            <h1 class="text-white">Formations</h1>
            <p class="lead mb-3"><t t-out="published_count"/> formation(s), en session inter-entreprises, pour votre équipe ou en autonomie.</p>
            <form action="/formations" method="get" role="search" class="d-flex flex-wrap gap-0 o_training_catalogue_search">
              <label for="search" class="visually-hidden">Rechercher une formation</label>
              <input id="search" name="search" type="search" class="form-control form-control-lg rounded-0 flex-grow-1" placeholder="Intitulé, outil, certification…" t-att-value="search"/>
              <input t-foreach="hidden_options.items()" t-as="item" type="hidden" t-att-name="item[0]" t-att-value="item[1]"/>
              <button class="btn btn-lg btn-warning rounded-0 fw-bold">Rechercher</button>
            </form>
            <p t-if="suggestions" class="small mt-3 mb-0 d-flex flex-wrap gap-2 align-items-center">
              <span>Recherches fréquentes :</span>
              <a t-foreach="suggestions" t-as="item" class="btn btn-sm btn-outline-light rounded-0" t-att-href="item['url']" t-out="item['label']"/>
            </p>
          </div>
        </section>
        <nav class="bg-body-tertiary border-bottom" aria-label="Formats de formation">
          <div class="container d-flex flex-wrap o_training_catalogue_formats_nav">
            <a t-foreach="formats" t-as="item" t-att-href="item['url']" t-att-aria-current="'page' if item['selected'] else None"
               class="px-3 py-3 text-decoration-none text-body">
              <span class="d-block fw-bold"><t t-out="item['label']"/> <span class="fw-normal">(<t t-out="item['count']"/>)</span></span>
              <span t-if="item['hint']" class="d-block small text-body-secondary" t-out="item['hint']"/>
            </a>
          </div>
        </nav>
        <div class="container py-4">
          <div class="row g-4">
            <aside class="col-lg-3" aria-label="Filtres">
              <details class="d-lg-none mb-3"><summary class="btn btn-outline-primary w-100">Filtrer<t t-if="active_facets"> (<t t-out="len(active_facets)"/>)</t></summary>
                <t t-call="training_catalog.public_catalogue_facets"/>
              </details>
              <div class="d-none d-lg-block"><t t-call="training_catalog.public_catalogue_facets"/></div>
              <div id="training_catalogue_aside" class="mt-4"/>
            </aside>
            <section class="col-lg-9" aria-label="Résultats">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <p class="mb-0" role="status"><strong t-out="result_count"/> formation(s)</p>
                <nav class="small d-flex flex-wrap gap-2 align-items-center" aria-label="Trier les résultats">
                  <span>Trier par :</span>
                  <a t-foreach="sorts" t-as="item" t-att-href="item['url']" t-att-aria-current="'true' if item['selected'] else None"
                     t-attf-class="text-decoration-none #{'fw-bold text-body' if item['selected'] else ''}" t-out="item['label']"/>
                </nav>
              </div>
              <ul t-if="active_facets" class="list-unstyled d-flex flex-wrap gap-2 mb-3" aria-label="Filtres actifs">
                <li t-foreach="active_facets" t-as="item"><a class="btn btn-sm btn-light border rounded-0" t-att-href="item['url']"><t t-out="item['label']"/> <span aria-hidden="true">×</span><span class="visually-hidden"> (retirer)</span></a></li>
                <li><a class="btn btn-sm btn-link" t-att-href="clear_url">Tout effacer</a></li>
              </ul>
              <p t-if="not courses">Aucune formation ne correspond à ces critères.</p>
              <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                <t t-foreach="courses" t-as="course"><t t-call="training_catalog.public_catalogue_card"/></t>
              </div>
              <nav t-if="pager['page_count'] &gt; 1" class="d-flex justify-content-center mt-4" aria-label="Pages du catalogue">
                <t t-call="portal.pager" classname.f="flex-wrap justify-content-center"/>
              </nav>
            </section>
          </div>
        </div>
      </div>
    </t>
  </template>
  <template id="public_catalogue_facets" name="Public catalogue filters">
    <div class="d-flex justify-content-between align-items-baseline mb-2">
      <h2 class="h5 mb-0">Affiner</h2>
      <a t-if="active_facets" class="small" t-att-href="clear_url">Tout effacer</a>
    </div>
    <div t-foreach="facet_groups" t-as="group" class="border-top py-3">
      <h3 class="h6 fw-bold" t-out="group[0]"/>
      <ul class="list-unstyled mb-0 d-flex flex-column gap-1 small">
        <li t-foreach="group[1]" t-as="item">
          <a t-att-href="item['url']" t-att-aria-current="'true' if item['selected'] else None"
             t-attf-class="d-flex justify-content-between gap-2 text-decoration-none py-1 #{'fw-bold' if item['selected'] else 'text-body'}">
            <span><span t-if="item['selected']" aria-hidden="true">✓ </span><t t-out="item['label']"/></span>
            <span class="text-body-secondary" t-out="item['count']"/>
          </a>
        </li>
      </ul>
    </div>
  </template>
  <template id="public_course" name="General training presentation">
    <!-- Set before the call: the layout head is rendered before the call body. -->
    <t t-set="additional_title" t-value="course['name']"/>
    <t t-call="portal.frontend_layout">
      <div id="wrap" class="container py-4 o_training_public_page o_not_editable">
        <a href="/formations">Catalogue</a><h1 t-out="course['name']"/>
        <img t-if="public_logo" t-att-src="image_data_uri(public_logo)" alt="" class="img-fluid d-block my-3"/>
        <p style="white-space:pre-wrap" t-out="course['presentation']"/>
        <dl t-if="public_reference or live_duration" class="d-flex flex-wrap gap-4 my-3">
          <div t-if="public_reference"><dt>Référence</dt><dd t-out="public_reference"/></div>
          <div t-if="live_duration">
            <dt>Durée avec formateur</dt>
            <dd><t t-out="live_duration_label"/> <t t-if="live_duration &lt; 2">jour</t><t t-else="">jours</t></dd>
          </div>
        </dl>
        <t t-call="training_catalog.public_course_tags" tags="course['tags']"/>
        <div id="training_course_actions" class="d-flex flex-wrap gap-2 my-3"/>
        <owl-component name="training_catalog.CourseShare" t-att-props="json.dumps(course_share)"/>
        <noscript><a t-att-href="course_share['email']">Partager par e-mail</a></noscript>
        <section t-if="course['objectives']"><h2>Objectifs généraux</h2><p style="white-space:pre-wrap" t-out="course['objectives']"/></section>
        <section t-if="public_programme" id="training_course_programme" aria-label="Programme de la formation" class="mt-4">
          <div class="o_training_course_programme" t-out="public_programme"/>
        </section>
        <section t-if="course['offers']"><h2>Offres disponibles</h2>
          <article t-foreach="course['offers']" t-as="offer" class="card my-3"><div class="card-body">
            <h3 class="h5"><t t-out="offer['kind']"/> : <t t-out="offer['title']"/></h3>
            <p style="white-space:pre-wrap" t-out="offer['conditions']"/>
            <a class="btn btn-outline-primary" t-att-href="offer['url']" t-out="offer['action']"/>
          </div></article>
        </section>
        <section t-if="general_presentation_published and (public_reviews or review_status)" id="training_course_reviews" class="my-4">
          <h2>Avis clients</h2>
          <p t-if="review_status == 'pending'" role="status">Votre avis a été reçu. Il sera publié après validation.</p>
          <p t-if="review_status == 'published'">Votre avis est publié.</p>
          <p t-if="review_status == 'not_published'">Votre avis n’est pas publié.</p>
          <form t-if="review_status == 'eligible'" method="post" t-att-action="review_route" class="border rounded p-3 mb-3">
            <h3 class="h5">Donner mon avis</h3>
            <div t-if="review_error" class="alert alert-danger" role="alert" t-out="review_error"/>
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="mb-3">
              <label class="form-label" for="training_review_score">Note sur 5</label>
              <select id="training_review_score" name="score" class="form-select w-auto" required="required">
                <option value="">Choisir</option>
                <option t-foreach="('1', '2', '3', '4', '5')" t-as="score" t-att-value="score"
                        t-att-selected="review_values.get('score') == score" t-out="score"/>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label" for="training_review_feedback">Votre commentaire</label>
              <textarea id="training_review_feedback" name="feedback" class="form-control" required="required"
                        maxlength="2000" rows="4" t-out="review_values.get('feedback', '')"/>
            </div>
            <label class="d-block mb-3">
              <input type="checkbox" name="consent" value="1" required="required"/>
              J’accepte la publication de ma note et de mon commentaire après validation.
            </label>
            <button type="submit" class="btn btn-primary">Envoyer mon avis</button>
          </form>
          <p t-if="not public_reviews" class="text-muted">Aucun avis publié pour cette formation.</p>
          <ul t-else="" class="list-unstyled">
            <li t-foreach="public_reviews" t-as="review" class="border-bottom py-2">
              <p class="fw-semibold"><t t-out="review['rating']"/> / 5</p>
              <p t-if="review['feedback']" class="text-break" t-out="review['feedback']"/>
            </li>
          </ul>
        </section>
      </div>
    </t>
  </template>
</odoo>
