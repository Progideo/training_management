<odoo>
  <template id="public_course_tags" name="Public catalogue tags">
    <ul t-if="tags" class="o_training_catalogue_tags list-unstyled d-flex flex-wrap gap-1 mb-2" role="list" aria-label="Étiquettes">
      <li t-foreach="tags" t-as="tag"
          t-attf-class="badge border text-wrap text-start #{'o_wslides_channel_tag o_color_%s' % tag['color'] if tag['color'] else 'text-bg-light'}"
          t-out="tag['label']"/>
    </ul>
  </template>
  <template id="public_catalogue" name="General training catalogue">
    <t t-call="portal.frontend_layout" additional_title.translate="Formations">
      <div id="wrap" class="container py-4 o_training_public_page o_not_editable">
        <h1>Formations</h1>
        <form action="/formations" method="get" class="row g-3 mb-4">
          <div class="col-md-4"><label for="search">Rechercher</label><input id="search" name="search" class="form-control" t-att-value="search"/></div>
          <div class="col-md-3"><label for="category">Catégorie</label><select id="category" name="category" class="form-select"><option value="">Toutes</option><option t-foreach="categories" t-as="item" t-att-value="item[0]" t-att-selected="str(item[0]) == category" t-out="item[1]"/></select></div>
          <div class="col-md-3"><label for="mode">Modalité</label><select id="mode" name="mode" class="form-select"><option value="">Toutes</option><option value="onsite" t-att-selected="mode == 'onsite'">Présentiel</option><option value="remote" t-att-selected="mode == 'remote'">Distanciel</option><option value="blended" t-att-selected="mode == 'blended'">Mixte</option><option value="autonomous" t-att-selected="mode == 'autonomous'">Autonome</option></select></div>
          <div class="col-md-2 align-self-end"><button class="btn btn-primary">Rechercher</button></div>
        </form>
        <p t-if="not courses">Aucune formation publiée.</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          <article t-foreach="courses" t-as="course" class="col">
            <div class="card h-100 rounded-0 border o_training_catalogue_card"><div class="card-body d-flex flex-column position-relative text-break">
              <h2 class="h5"><a class="stretched-link text-decoration-none" t-att-href="'/formations/catalogue/%s' % course['id']" t-out="course['name']"/></h2>
              <p t-if="course['presentation']" class="mb-2" style="white-space:pre-wrap" t-out="course['presentation']"/>
              <t t-call="training_catalog.public_course_tags" tags="course['tags']"/>
              <ul t-if="course['offers']" class="small mb-2">
                <li t-foreach="course['offers']" t-as="offer"><a class="position-relative z-2" t-att-href="offer['url']"><t t-out="offer['kind']"/> : <t t-out="offer['title']"/></a></li>
              </ul>
              <span class="mt-auto pt-2 fw-bold text-primary" aria-hidden="true">Voir la fiche →</span>
            </div></div>
          </article>
        </div>
        <nav t-if="pager['page_count'] &gt; 1" class="d-flex justify-content-center mt-4" aria-label="Pages du catalogue">
          <t t-call="portal.pager" classname.f="flex-wrap justify-content-center"/>
        </nav>
      </div>
    </t>
  </template>
  <template id="public_course" name="General training presentation">
    <t t-call="portal.frontend_layout" additional_title.translate="Formations">
      <div id="wrap" class="container py-4 o_training_public_page o_not_editable">
        <a href="/formations">Catalogue</a><h1 t-out="course['name']"/>
        <p style="white-space:pre-wrap" t-out="course['presentation']"/>
        <t t-call="training_catalog.public_course_tags" tags="course['tags']"/>
        <div id="training_course_actions" class="d-flex flex-wrap gap-2 my-3"/>
        <details class="mb-4">
          <summary>Partager cette formation</summary>
          <div class="d-flex flex-wrap gap-2 my-2">
            <a class="btn btn-outline-secondary" t-att-href="share_email">Par e-mail</a>
            <a class="btn btn-outline-secondary" t-att-href="share_whatsapp">Sur WhatsApp</a>
          </div>
          <label for="training_share_url">Lien de la fiche</label>
          <input id="training_share_url" class="form-control" type="url" readonly="readonly" t-att-value="share_url"/>
        </details>
        <section t-if="course['objectives']"><h2>Objectifs généraux</h2><p style="white-space:pre-wrap" t-out="course['objectives']"/></section>
        <section t-if="public_programme" id="training_course_programme" aria-label="Programme de la formation" class="mt-4">
          <div class="o_training_course_programme" t-out="public_programme"/>
        </section>
        <section t-if="course['offers']"><h2>Offres disponibles</h2>
          <article t-foreach="course['offers']" t-as="offer" class="card my-3"><div class="card-body">
            <h3 class="h5"><t t-out="offer['kind']"/> : <t t-out="offer['title']"/></h3>
            <p style="white-space:pre-wrap" t-out="offer['conditions']"/>
            <a class="btn btn-outline-primary" t-att-href="offer['url']" t-out="offer['action']"/>
          </div></article>
        </section>
      </div>
    </t>
  </template>
</odoo>
