<odoo>
    <record id="view_company_form_course_reviews" model="ir.ui.view">
        <field name="name">res.company.form.course.reviews</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Course Reviews" groups="base.group_system">
                    <group>
                        <field name="course_review_responsible_id" options="{'no_create': True}"/>
                        <field name="training_catalogue_new_months"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
