<odoo>
    <record id="privilege_catalog" model="res.groups.privilege">
        <field name="name">Training Catalogue</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_catalog_reader" model="res.groups">
        <field name="name">Catalogue Reader</field>
        <field name="privilege_id" ref="privilege_catalog"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_catalog_editor" model="res.groups">
        <field name="name">Catalogue Editor</field>
        <field name="privilege_id" ref="privilege_catalog"/>
        <field name="implied_ids" eval="[(4, ref('group_catalog_reader'))]"/>
    </record>
</odoo>
