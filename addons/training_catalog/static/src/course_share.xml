<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="training_catalog.CourseShare">
        <div class="o_training_course_share_link">
            <label class="visually-hidden" for="training_share_url">Lien de la fiche</label>
            <input id="training_share_url" class="form-control" type="url" readonly="readonly" t-att-value="this.props.url"
                   t-on-focus="(ev) => ev.target.select()"/>
            <CopyButton className="'btn btn-primary'" copyText="'Copier le lien'" successText="'Lien copié'" content="this.props.url"/>
        </div>
        <ul class="o_training_course_share_networks" aria-label="Partager sur les réseaux sociaux">
            <li t-foreach="this.networks" t-as="network" t-key="network.key">
                <a t-att-href="network.href" t-att-target="network.local ? undefined : '_blank'"
                   t-att-rel="network.local ? undefined : 'noopener noreferrer'"
                   t-attf-class="o_training_course_share_{{ network.key }}"
                   t-att-title="network.label">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" t-att-d="network.path"/></svg>
                    <span class="visually-hidden" t-out="network.local ? 'Partager par e-mail' : 'Partager sur ' + network.label"/>
                </a>
            </li>
        </ul>
    </t>
</templates>
