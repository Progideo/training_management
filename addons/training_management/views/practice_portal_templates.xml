<odoo>
    <template id="practice_home" inherit_id="training_management.portal_trainings" name="Post-training Practice Navigation">
        <xpath expr="//div[@id='training_personal_links']" position="inside"><t t-if="training_links.get('practice')"><div class="card p-3 my-2"><a href="/my/training-practice">My practice plans</a></div></t></xpath>
    </template>
    <template id="practice_from_trainings" inherit_id="portal_trainings" name="Practice Plans Navigation">
        <!-- Preserve the existing view id on upgrade; practice_home supplies the authorized link. -->
        <xpath expr="//h1" position="after"><t/></xpath>
    </template>
    <template id="practice_portal" name="My Practice Plans">
        <t t-call="portal.portal_layout" additional_title.translate="My practice plans">
            <div class="container py-4">
                <a href="/my/trainings">My training</a><h1>My practice plans</h1>
                <p>Optional evidence and trainer comments remain private. Your employer receives only a separately agreed and authorized summary.</p>
                <div t-if="error" id="practice_error" role="alert" tabindex="-1" autofocus="autofocus" class="alert alert-danger o_training_feedback" t-out="error"/>
                <p t-if="not rows">No practice action is currently assigned.</p>
                <section t-foreach="rows" t-as="row" class="border rounded p-3 my-3 text-break">
                    <h2 class="h4" t-out="row['name']"/><p><t t-out="row['training']"/> · <t t-out="row['participant']"/></p>
                    <p>Due: <t t-out="row['due']"/> · <strong t-out="row['state_label']"/></p>
                    <ul class="list-unstyled"><li t-foreach="row['entries']" t-as="entry" class="border-top py-2">
                        <p><t t-out="entry['kind']"/> · <t t-out="entry['author']"/> · <t t-out="entry['date']"/></p>
                        <p style="white-space:pre-wrap" t-out="entry['body']"/>
                        <a t-if="entry['filename']" t-att-href="'/my/training-practice/%s/files/%s' % (row['id'], entry['id'])" t-out="entry['filename']"/>
                    </li></ul>
                    <form t-if="(row['role'] == 'participant' and row['state'] == 'planned') or (row['role'] == 'trainer' and row['state'] == 'done')" method="post" enctype="multipart/form-data" t-att-action="'/my/training-practice/%s' % row['id']">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="role" t-att-value="row['role']"/>
                        <label t-att-for="'practice_body_%s' % row['id']"><t t-if="row['role'] == 'participant'">Completion note (optional)</t><t t-else="">Trainer comment</t></label>
                        <textarea name="body" class="form-control mb-3" t-att-id="'practice_body_%s' % row['id']" t-att-required="row['role'] == 'trainer' or None"><t t-if="draft_id == row['id']" t-out="draft"/></textarea>
                        <label t-att-for="'practice_file_%s' % row['id']">Private evidence (optional, up to 20 MB)</label>
                        <input type="file" name="file" class="form-control mb-3" t-att-id="'practice_file_%s' % row['id']"/>
                        <button class="btn btn-primary"><t t-if="row['role'] == 'participant'">Mark as done</t><t t-else="">Record trainer comment</t></button>
                    </form>
                </section>
            </div>
        </t>
    </template>
</odoo>
