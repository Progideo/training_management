<odoo>
    <record id="view_training_delivery_list" model="ir.ui.view">
        <field name="name">training.delivery.list</field>
        <field name="model">training.delivery</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="program_id"/>
                <field name="kind"/>
                <field name="state"/>
                <field name="capacity"/>
                <field name="occupied_seats"/>
                <field name="below_threshold"/>
            </list>
        </field>
    </record>
    <record id="view_training_delivery_search" model="ir.ui.view">
        <field name="name">training.delivery.search</field>
        <field name="model">training.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Delivery" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="program_id"/>
                <field name="responsible_id"/>
                <filter groups="training_management.group_training_coordinator" name="to_process" string="To Process" domain="['|', '|', ('enrollment_ids', 'any', [('state', '=', 'requested')]), ('allocation_ids', 'any', [('state', '=', 'reserved'), ('expires_at', '&lt;', time.strftime('%Y-%m-%d %H:%M:%S'))]), ('enrollment_ids', 'any', [('state', '=', 'confirmed'), ('access_state', '=', 'unopened'), ('commercially_authorized', '=', True)])]"/>
                <separator/>
                <filter name="live" string="Not Finished" domain="[('state', 'in', ('preparation', 'confirmed', 'ongoing'))]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_program" string="Programme" context="{'group_by': 'program_id'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_training_delivery_form" model="ir.ui.view">
        <field name="name">training.delivery.form</field>
        <field name="model">training.delivery</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button groups="training_management.group_training_coordinator" name="action_confirm" type="object" string="Confirm" invisible="state != 'preparation' or below_threshold"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Confirm below Threshold" context="{'reason_action': 'action_confirm'}" invisible="state != 'preparation' or not below_threshold"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_dates" type="object" string="Change Dates" invisible="state not in ('preparation', 'confirmed')"/>
                    <button groups="training_management.group_training_coordinator" name="action_start" type="object" string="Start" invisible="state != 'confirmed'"/>
                    <button groups="training_management.group_training_coordinator" name="action_deliver" type="object" string="Mark Delivered" invisible="state != 'ongoing'"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Close" context="{'reason_action': 'action_close'}" invisible="state != 'delivered'"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Cancel Delivery" context="{'reason_action': 'action_cancel'}" invisible="state in ('closed', 'cancelled')" confirm="Cancel the delivery, revoke its enrollments and release its allocations? Commercial documents are preserved."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="reference"/>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="program_id" domain="[('state', 'in', ('validated', 'published', 'retired'))]"/>
                        <field name="kind"/>
                        <field name="delivery_mode"/>
                        <field name="responsible_id"/>
                        <field name="start_at" invisible="kind == 'autonomous'"/>
                        <field name="end_at" invisible="kind == 'autonomous'"/>
                        <field name="timezone"/>
                        <field name="capacity"/>
                        <field name="occupied_seats"/>
                        <field name="opening_threshold"/>
                        <field name="below_threshold"/>
                        <field name="access_policy"/>
                        <field name="access_start" invisible="access_policy != 'fixed'"/>
                        <field name="access_end" invisible="access_policy != 'fixed'"/>
                        <field name="access_days" invisible="access_policy != 'duration'"/>
                        <field name="access_months" invisible="access_policy != 'months'"/>
                        <field name="reservation_days"/>
                    </group>
                    <notebook>
                        <page string="Places">
                            <field name="allocation_ids" readonly="1"/>
                        </page>
                        <page string="Enrollments">
                            <field name="enrollment_ids" readonly="1"/>
                        </page>
                        <page string="History" groups="training_management.group_training_coordinator">
                            <field name="operation_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="occurred_at"/>
                                    <field name="actor_id"/>
                                    <field name="record_label"/>
                                    <field name="reason"/>
                                    <field name="changes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_training_allocation_list" model="ir.ui.view">
        <field name="name">training.seat.allocation.list</field>
        <field name="model">training.seat.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="delivery_id"/>
                <field name="customer_id"/>
                <field name="source_reference"/>
                <field name="quantity"/>
                <field name="unnamed_seats"/>
                <field name="expires_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_training_allocation_search" model="ir.ui.view">
        <field name="name">training.seat.allocation.search</field>
        <field name="model">training.seat.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_reference"/>
                <field name="customer_id"/>
                <field name="delivery_id"/>
                <filter name="to_process" string="To Process" domain="[('state', '=', 'reserved'), ('expires_at', '&lt;', time.strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group>
                    <filter name="group_delivery" string="Delivery" context="{'group_by': 'delivery_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_training_allocation_form" model="ir.ui.view">
        <field name="name">training.seat.allocation.form</field>
        <field name="model">training.seat.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button groups="training_management.group_training_coordinator" name="action_confirm" type="object" string="Confirm Allocation" invisible="state != 'reserved'"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_extend" type="object" string="Extend Deadline" invisible="state != 'reserved'"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_release" type="object" string="Release Places" invisible="state not in ('reserved', 'confirmed')"/>
                    <button groups="training_management.group_training_coordinator" name="action_expire" type="object" string="Record Expiry" invisible="state != 'reserved'"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Cancel Allocation" context="{'reason_action': 'action_cancel'}" invisible="state in ('expired', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="delivery_id"/>
                        <field name="customer_id"/>
                        <field name="source_reference"/>
                        <field name="quantity"/>
                        <field name="unnamed_seats"/>
                        <field name="expires_at"/>
                    </group>
                    <field name="enrollment_ids" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_training_enrollment_list" model="ir.ui.view">
        <field name="name">training.enrollment.list</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="requested_at"/>
                <field name="delivery_id"/>
                <field name="participant_id"/>
                <field name="allocation_id"/>
                <field name="state"/>
                <field name="prerequisites"/>
                <field name="commercially_authorized"/>
                <field name="effective_access"/>
            </list>
        </field>
    </record>
    <record id="view_training_enrollment_search" model="ir.ui.view">
        <field name="name">training.enrollment.search</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="participant_id"/>
                <field name="delivery_id"/>
                <field name="allocation_id"/>
                <filter groups="training_management.group_training_coordinator" name="to_process" string="To Process" domain="['|', '|', ('state', '=', 'requested'), '&amp;', ('state', '=', 'reserved'), ('reservation_end', '&lt;', time.strftime('%Y-%m-%d %H:%M:%S')), '&amp;', '&amp;', ('state', '=', 'confirmed'), ('access_state', '=', 'unopened'), ('commercially_authorized', '=', True)]"/>
                <separator/>
                <filter name="requests" string="Requests" domain="[('state', '=', 'requested')]"/>
                <filter name="expired_reservations" string="Expired Reservations" domain="[('state', '=', 'reserved'), ('reservation_end', '&lt;', time.strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter groups="training_management.group_training_coordinator" name="access_to_open" string="Accesses to Open" domain="[('state', '=', 'confirmed'), ('access_state', '=', 'unopened'), ('commercially_authorized', '=', True)]"/>
                <group>
                    <filter name="group_delivery" string="Delivery" context="{'group_by': 'delivery_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_allocation" string="Allocation" context="{'group_by': 'allocation_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_training_enrollment_form" model="ir.ui.view">
        <field name="name">training.enrollment.form</field>
        <field name="model">training.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button groups="training_management.group_training_coordinator" name="action_wait" type="object" string="Waiting List" invisible="state != 'requested'"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_operation" type="object" string="Reserve a Place" context="{'operation': 'reserve'}" invisible="state not in ('requested', 'waiting', 'reserved')"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_operation" type="object" string="Extend Access" context="{'operation': 'extend'}" invisible="state != 'confirmed' or not access_end"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Validate Prerequisites" context="{'reason_action': 'action_validate_prerequisites'}" invisible="state in ('closed', 'cancelled', 'replaced', 'abandoned', 'postponed') or prerequisites != 'pending'" class="btn-primary"/>
                    <button groups="training_management.group_training_coordinator" name="action_confirm" type="object" string="Confirm Enrollment" invisible="state not in ('requested', 'reserved') or prerequisites == 'pending'" class="btn-primary"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Authorize Commercially" context="{'reason_action': 'action_authorize'}" invisible="state != 'confirmed' or commercially_authorized" class="btn-primary"/>
                    <button groups="training_management.group_training_coordinator" name="action_open_reason" type="object" string="Open / Resume Access" context="{'reason_action': 'action_open_access'}" invisible="state != 'confirmed' or not commercially_authorized or not user_id or access_state not in ('unopened', 'suspended')" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" groups="training_management.group_training_coordinator" invisible="state != 'confirmed' or effective_access == 'active'">
    <p invisible="commercially_authorized">Commercial authorization is required before opening access.</p>
    <p invisible="not commercially_authorized or not user_id or access_state != 'unopened'">Commercial authorization is recorded. Open access when the participant is ready.</p>
    <p invisible="user_id">Assign an active user account before opening access.</p>
</div><group>
                        <field name="company_id" invisible="1"/>
                        <field name="delivery_id"/>
                        <field name="program_id"/>
                        <field name="participant_id"/>
                        <field name="user_id"/>
                        <field name="allocation_id" domain="[('delivery_id', '=', delivery_id)]"/>
                        <field name="free_reason"/>
                        <field name="requested_at"/>
                        <field name="reservation_end"/>
                        <field name="prerequisites"/>
                        <field name="commercially_authorized"/>
                        <field name="access_state"/>
                        <field name="effective_access"/>
                        <field name="access_start"/>
                        <field name="access_end"/>
                        <field name="successor_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_training_deliveries" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">training.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_delivery_search"/>
    </record>
    <record id="action_training_allocations" model="ir.actions.act_window">
        <field name="name">Seat Allocations</field>
        <field name="res_model">training.seat.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_allocation_search"/>
    </record>
    <record id="action_training_enrollments" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">training.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_enrollment_search"/>
    </record>
    <menuitem id="menu_training_deliveries" name="Training Sessions" parent="menu_training_organisation" action="action_training_deliveries" groups="training_management.group_training_coordinator" sequence="10"/>
    <menuitem id="menu_training_allocations" name="Seat Allocations" parent="menu_training_organisation" action="action_training_allocations" groups="training_management.group_training_coordinator" sequence="40"/>
    <menuitem id="menu_training_enrollments" name="Enrollments" parent="menu_training_organisation" action="action_training_enrollments" groups="training_management.group_training_coordinator" sequence="30"/>
</odoo>
