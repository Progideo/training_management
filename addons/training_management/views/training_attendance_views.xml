<odoo>
    <record id="view_attendance_list" model="ir.ui.view"><field name="name">training.attendance.list</field><field name="model">training.attendance</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="session_id"/><field name="enrollment_id"/><field name="state"/><field name="minutes"/><field name="late_minutes"/><field name="absent"/></list></field></record>
    <record id="view_attendance_form" model="ir.ui.view"><field name="name">training.attendance.form</field><field name="model">training.attendance</field><field name="arch" type="xml"><form create="0" edit="0" delete="0" duplicate="0"><sheet><group><field name="session_id"/><field name="enrollment_id"/><field name="state"/><field name="minutes"/><field name="late_minutes"/><field name="absent"/></group><field name="event_ids"><list create="0" edit="0" delete="0"><field name="kind"/><field name="actor_id"/><field name="occurred_at"/><field name="start_at"/><field name="end_at"/><field name="absent"/><field name="anomaly"/><field name="reason"/></list></field></sheet></form></field></record>
    <record id="view_attendance_event_form" model="ir.ui.view"><field name="name">training.attendance.event.form</field><field name="model">training.attendance.event</field><field name="arch" type="xml"><form create="0" edit="0" delete="0" duplicate="0"><sheet><group><field name="attendance_id"/><field name="kind"/><field name="actor_id"/><field name="occurred_at"/><field name="start_at"/><field name="end_at"/><field name="absent"/><field name="anomaly"/><field name="wording"/><field name="reason"/><field name="before"/><field name="after"/><field name="filename" invisible="1"/><field name="data" filename="filename"/></group></sheet></form></field></record>
    <record id="view_attendance_edit" model="ir.ui.view"><field name="name">training.attendance.edit.form</field><field name="model">training.attendance.edit</field><field name="arch" type="xml"><form string="Record Paper / Correct Attendance"><group><field name="session_id"/><field name="delivery_id" invisible="1"/><field name="enrollment_id" domain="[('delivery_id', '=', delivery_id), ('state', '=', 'confirmed')]"/><field name="operation"/><field name="revision" invisible="1" force_save="1"/><field name="absent"/><field name="start_minutes" invisible="absent"/><field name="end_minutes" invisible="absent"/><field name="reason"/><field name="filename" invisible="1"/><field name="data" filename="filename"/></group><p>Signed paper remains pending until a distinct trainer validates it. Corrections preserve every previous declaration and evidence file.</p><footer><button name="action_apply" type="object" string="Save Evidence" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_session_attendance" model="ir.ui.view"><field name="name">training.session.attendance</field><field name="model">training.session</field><field name="inherit_id" ref="view_training_session_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_attendance" type="object" string="Attendance"/><button name="action_record_attendance" type="object" string="Import Paper / Correct"/></xpath><xpath expr="//sheet" position="inside"><group string="Attendance Collection"><field name="attendance_mode"/><field name="attendance_before"/><field name="attendance_after"/><field name="attendance_wording"/></group></xpath></field></record>
    <record id="view_session_edit_attendance" model="ir.ui.view"><field name="name">training.session.edit.attendance</field><field name="model">training.session.edit</field><field name="inherit_id" ref="view_training_session_edit_form"/><field name="arch" type="xml"><xpath expr="//footer" position="before"><group string="Attendance Collection"><field name="attendance_mode"/><field name="attendance_before"/><field name="attendance_after"/><field name="attendance_wording"/></group></xpath></field></record>
    <template id="portal_training_attendance_link" inherit_id="portal_training" name="Participant Attendance Link"><xpath expr="//h2[1]" position="before"><p><a t-att-href="'/my/trainings/%s/attendance' % learning['id']" class="btn btn-outline-primary">My attendance</a></p></xpath></template>
    <template id="portal_trainer_attendance_link" inherit_id="portal_trainer_session" name="Trainer Attendance Link"><xpath expr="//h2[1]" position="before"><p><a t-att-href="'/my/training-sessions/%s/attendance' % session['id']" class="btn btn-outline-primary">Review attendance</a></p></xpath></template>
    <template id="portal_attendance" name="Session Attendance">
        <t t-call="portal.portal_layout"><h1 t-out="name"/><h2 t-if="trainer">Review attendance</h2><h2 t-else="">My attendance</h2>
            <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
            <p t-if="not rows">No scheduled session.</p>
            <section t-foreach="rows" t-as="row" class="card p-3 my-3">
                <h3 t-out="row['participant'] if trainer else row['name']"/><p><t t-out="row['schedule']"/> (<t t-out="row['timezone']"/>)</p>
                <p><strong t-out="row['state']"/> — <t t-out="row['minutes']"/> validated minutes</p>
                <form t-if="(trainer and not row['validated']) or (not trainer and not row['declared'] and row['mode'] != 'paper')" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="session_id" t-att-value="row['session_id']"/><input type="hidden" name="enrollment_id" t-att-value="row['enrollment_id']"/><input type="hidden" name="revision" t-att-value="str(row['revision'])"/>
                    <p>Enter arrival and departure as minutes after the scheduled start. Example: 30 to 120 means 90 minutes attended.</p>
                    <label class="d-block">Arrival (minutes after start)<input class="form-control mb-2" name="start" type="number" min="0" t-att-max="row['duration']" t-att-value="str(row['start'])" step="any" required="required"/></label>
                    <label class="d-block">Departure (minutes after start)<input class="form-control mb-2" name="end" type="number" min="0" t-att-max="row['duration']" t-att-value="str(row['end'])" step="any" required="required"/></label>
                    <t t-if="trainer"><label class="d-block mb-2"><input type="checkbox" name="absent" value="yes"/> Absent</label><label class="d-block">Review comment (required for an anomaly)<textarea name="reason" class="form-control mb-2"/></label></t>
                    <label t-else="" class="d-block mb-2"><input type="checkbox" name="accepted" value="yes" required="required"/> <t t-out="row['wording']"/></label>
                    <button class="btn btn-primary" type="submit"><t t-if="trainer">Validate attendance</t><t t-else="">Confirm my attendance</t></button>
                </form>
                <p t-if="not trainer and row['declared']">Your declaration is recorded. Contact the coordinator for a correction.</p>
                <p t-if="not trainer and row['mode'] == 'paper'">Attendance is collected on signed paper for this session.</p>
                <details t-if="row['history']" class="mt-3"><summary>Declaration and review history</summary><ul><li t-foreach="row['history']" t-as="event"><t t-out="event['kind']"/> — <t t-out="event['date']"/> — <t t-out="event['actor']"/><strong t-if="event['anomaly']"> — Outside declaration window</strong><p t-out="event['reason']"/></li></ul></details>
            </section>
        </t>
    </template>
</odoo>
