<odoo>
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">training.attendance.list</field>
        <field name="model">training.attendance</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="session_id"/>
                <field name="enrollment_id"/>
                <field name="period_label"/>
                <field name="state"/>
                <field name="minutes"/>
                <field name="late_minutes"/>
                <field name="absent"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">training.attendance.form</field>
        <field name="model">training.attendance</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="enrollment_id"/>
                        <field name="period_label"/>
                        <field name="state"/>
                        <field name="minutes"/>
                        <field name="late_minutes"/>
                        <field name="absent"/>
                    </group>
                    <field name="event_ids">
                        <list create="0" edit="0" delete="0">
                            <field name="kind"/>
                            <field name="actor_id"/>
                            <field name="occurred_at"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="absent"/>
                            <field name="anomaly"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_attendance_event_form" model="ir.ui.view">
        <field name="name">training.attendance.event.form</field>
        <field name="model">training.attendance.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="attendance_id"/>
                        <field name="kind"/>
                        <field name="actor_id"/>
                        <field name="occurred_at"/>
                        <field name="start_at"/>
                        <field name="end_at"/>
                        <field name="absent"/>
                        <field name="anomaly"/>
                        <field name="wording"/>
                        <field name="reason"/>
                        <field name="before"/>
                        <field name="after"/>
                        <field name="filename" invisible="1"/>
                        <field name="data" filename="filename"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_attendance_edit" model="ir.ui.view">
        <field name="name">training.attendance.edit.form</field>
        <field name="model">training.attendance.edit</field>
        <field name="arch" type="xml">
            <form string="Record Paper / Correct Attendance">
                <group>
                    <field name="session_id"/>
                    <field name="delivery_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="enrollment_id" domain="[('delivery_id', '=', delivery_id), ('state', '=', 'confirmed')]"/>
                    <field name="operation"/>
                    <field name="revision" invisible="1" force_save="1"/>
                    <field name="definition" invisible="1" force_save="1"/>
                    <field name="absent" invisible="operation == 'invalidation'"/>
                    <field name="period_date" invisible="halfday == 'legacy'" required="halfday != 'legacy'"/>
                    <field name="halfday"/>
                    <field name="period_key" invisible="1" force_save="1"/>
                    <field name="reason"/>
                    <field name="filename" invisible="1"/>
                    <field name="data" filename="filename" invisible="operation == 'invalidation'" required="operation != 'invalidation'"/>
                </group>
                <p>Signed paper remains pending until a distinct trainer validates it. Corrections preserve every previous declaration and evidence file.</p>
                <footer><button name="action_apply" type="object" string="Save Evidence" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="view_session_attendance" model="ir.ui.view">
        <field name="name">training.session.attendance</field>
        <field name="model">training.session</field>
        <field name="inherit_id" ref="view_training_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_attendance" type="object" string="Attendance"/><button name="action_record_attendance" type="object" string="Paper / Correct / Invalidate"/></xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Attendance Collection">
                    <field name="attendance_mode"/>
                    <field name="attendance_before" invisible="1"/>
                    <field name="attendance_after" invisible="1"/>
                    <field name="attendance_wording"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_session_edit_attendance" model="ir.ui.view">
        <field name="name">training.session.edit.attendance</field>
        <field name="model">training.session.edit</field>
        <field name="inherit_id" ref="view_training_session_edit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <group string="Attendance Collection">
                    <field name="attendance_mode"/>
                    <field name="attendance_before" invisible="1"/>
                    <field name="attendance_after" invisible="1"/>
                    <field name="attendance_wording"/>
                </group>
            </xpath>
        </field>
    </record>
    <template id="portal_training_attendance_link" inherit_id="portal_training" name="Participant Attendance Link">
        <xpath expr="//h2[1]" position="before">
            <p t-if="sessions"><a t-att-href="'/my/trainings/%s/attendance' % learning['id']" class="btn btn-outline-primary">My attendance</a></p>
        </xpath>
    </template>
    <template id="portal_trainer_attendance_link" inherit_id="portal_trainer_session" name="Trainer Attendance Link">
        <xpath expr="//h2[1]" position="before">
            <p><a t-att-href="'/my/training-sessions/%s/attendance?%s' % (session['id'], session_query)" class="btn btn-outline-primary">Review attendance</a></p>
        </xpath>
    </template>
    <template id="portal_attendance" name="Session Attendance">
        <t t-call="portal.portal_layout">
            <t t-call="training_management.portal_training_navigation"/>
            <p><a t-att-href="attendance_back">Back to training</a></p>
            <h1 t-out="name"/>
            <h2 t-if="trainer">Review attendance</h2>
            <h2 t-else="">My attendance</h2>
            <div t-if="error and not any(row['error'] for row in rows)" class="alert alert-danger o_training_feedback" role="alert" tabindex="-1" t-out="error"/>
            <div t-if="saved" id="attendance-feedback" tabindex="-1" class="alert alert-success o_training_feedback" role="status">Your attendance decision has been recorded.</div>
            <p><a href="/my/training-signature">My signature</a><a t-if="trainer" t-att-href="matrix_url" class="ms-3">All attendance by day and half-day</a></p>
            <t t-call="training_management.attendance_matrix_table"/>
            <p t-if="not rows">No scheduled session.</p>
            <details t-foreach="rows" t-as="row" t-att-id="row['anchor']" t-att-open="row['error'] or None" class="card p-3 my-3 tm_attendance_details">
                <summary><t t-out="row['participant'] if trainer else row['name']"/> — <t t-out="row['period']"/> — <t t-out="row['state']"/></summary>
                <div t-if="row['error']" class="alert alert-danger o_training_feedback" role="alert" tabindex="-1" t-out="error"/>
                <h3 t-out="row['participant'] if trainer else row['name']"/>
                <p><t t-out="row['period']"/> (<t t-out="row['timezone']"/>)</p>
                <ul><li t-foreach="row['schedule']" t-as="part"><t t-out="part['name']"/> — <t t-out="part['start']"/> → <t t-out="part['end']"/> (<t t-out="part['timezone']"/>)</li></ul>
                <p><strong t-out="row['state']"/> — <t t-out="row['minutes']"/> validated minutes</p>
                <p t-if="not row['elapsed']" role="status">This half-day has not ended yet. Attendance can be recorded afterwards.</p>
                <p t-if="trainer and not row['can_review'] and not row['validated']" role="status">Another assigned trainer must review this attendance.</p>
                <form t-if="row['elapsed'] and ((trainer and row['can_review'] and not row['validated']) or (not trainer and not row['declared'] and row['mode'] != 'paper' and row['period_key'] != 'legacy'))" method="post" class="o_training_attendance_form">
                    <input type="hidden" name="period_key" t-att-value="row['period_key']"/><input type="hidden" name="definition" t-att-value="row['definition']"/><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="session_id" t-att-value="row['session_id']"/><input type="hidden" name="enrollment_id" t-att-value="row['enrollment_id']"/><input type="hidden" name="revision" t-att-value="str(row['revision'])"/>
                    <input type="hidden" name="signature_version" t-att-value="signature_version"/>
                    <div t-if="has_signature" class="my-2"><p>Your signature for this confirmation</p><img src="/my/training-signature/image" alt="My saved signature" width="180" height="60" class="object-fit-contain"/></div>
                    <p t-else=""><a href="/my/training-signature">Save your personal signature, then return and reload this page.</a></p>
                    <p>Confirm attendance for this half-day. Validated attendance counts for its scheduled duration.</p>
                    <p t-if="trainer and not row['has_source']" role="status">A participant declaration is needed to confirm presence. You may record an absence.</p>
                    <label class="d-block mb-2">Attendance status
                        <select name="attendance" class="form-select" required="required">
                            <option t-if="trainer and not row['has_source'] and not row['error']" value="" selected="selected">Choose present or absent</option>
                            <option value="present" t-att-disabled="trainer and not row['has_source'] or None" t-att-selected="not row['absent'] and (not trainer or row['has_source'])">Present</option>
                            <option value="absent" t-att-selected="row['absent']">Absent</option>
                        </select>
                    </label>
                    <t t-if="trainer"><p>I confirm the attendance status shown for this participant and half-day.</p><label class="d-block">Review comment (required for an anomaly)<textarea name="reason" class="form-control mb-2" t-out="row['reason']"/></label></t>
                    <label t-else="" class="d-block mb-2"><input type="checkbox" name="accepted" value="yes" required="required"/> <span class="tm_attendance_wording" t-att-data-present="row['wording']" t-att-data-absent="request.env._('I confirm that I was absent for this half-day.')"><t t-if="row['absent']">I confirm that I was absent for this half-day.</t><t t-else="" t-out="row['wording']"/></span></label>
                    <button class="btn btn-primary" type="submit" t-att-disabled="not has_signature or None"><t t-if="trainer">Sign and validate</t><t t-else="">Sign this half-day</t></button>
                </form>
                <form t-if="trainer and row['can_invalidate']" method="post">
                    <input type="hidden" name="operation" value="invalidate"/>
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="period_key" t-att-value="row['period_key']"/><input type="hidden" name="definition" t-att-value="row['definition']"/>
                    <input type="hidden" name="enrollment_id" t-att-value="row['enrollment_id']"/>
                    <input type="hidden" name="revision" t-att-value="str(row['revision'])"/>
                    <label>Reason for invalidation<textarea name="reason" required="required" class="form-control mb-2"/></label>
                    <button type="submit" class="btn btn-outline-danger">Invalidate attendance</button>
                </form>
                <p t-if="not trainer and row['declared']">Your declaration is recorded. Contact the coordinator for a correction.</p>
                <p t-if="not trainer and row['mode'] == 'paper'">Attendance is collected on signed paper for this session.</p>
                <details t-if="row['history']" class="mt-3">
                    <summary>Declaration and review history</summary>
                    <ul>
                        <li t-foreach="row['history']" t-as="event"><t t-out="event['kind']"/> — <t t-out="event['date']"/> — <t t-out="event['actor']"/><strong t-if="event['anomaly']"> — Outside declaration window</strong><strong t-if="event['status']"> · <t t-out="event['status']"/></strong><p t-if="event['wording']" t-out="event['wording']"/><p t-out="event['reason']"/><img t-if="event['signature_id']" t-att-src="'/my/training-attendance-signature/%s' % event['signature_id']" t-att-alt="event['actor']" width="150" height="50" class="object-fit-contain" loading="lazy"/></li>
                    </ul>
                </details>
            </details>
        </t>
    </template>
</odoo>
