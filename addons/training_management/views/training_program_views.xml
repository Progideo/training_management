<odoo>
    <record id="view_training_program_list" model="ir.ui.view">
        <field name="name">training.program.version.list</field>
        <field name="model">training.program.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="course_id"/>
                <field name="version"/>
                <field name="title"/>
                <field name="category_id"/>
                <field name="delivery_mode"/>
                <field name="duration_hours"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_training_program_form" model="ir.ui.view">
        <field name="name">training.program.version.form</field>
        <field name="model">training.program.version</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'draft'" groups="training_management.group_training_coordinator"/>
                    <button name="action_download_pdf" type="object" class="btn-primary" string="Download Programme PDF" invisible="state == 'draft' or not pdf_attachment_id"/>
                    <button name="action_publish" type="object" string="Publish Programme" invisible="state != 'validated'" groups="training_management.group_training_coordinator"/>
                    <button name="action_retire" type="object" string="Retire" invisible="state != 'published'" groups="training_management.group_training_coordinator"/>
                    <button name="action_new_version" type="object" string="New Version" groups="training_management.group_training_coordinator"/>
                    <button name="action_preview_pdf" type="object" string="Preview Draft PDF" invisible="state != 'draft'"/>
                    <button name="action_reconstruct_pdf" type="object" string="Reconstruct Historical PDF" invisible="not pdf_legacy or pdf_sha256" groups="training_management.group_training_coordinator"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,published,retired"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Validation freezes programme content. Use New Version to make changes.
                    </div>
                    <group>
                        <group>
                            <field name="course_id" readonly="state != 'draft'"/>
                            <field name="version" readonly="state != 'draft'"/>
                            <field name="title" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="duration_hours" readonly="state != 'draft'"/>
                            <field name="delivery_mode" readonly="state != 'draft'"/>
                            <field name="language_id" readonly="state != 'draft'"/>
                            <field name="pricing_mode" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="pdf_legacy" invisible="1"/>
                    <field name="pdf_sha256" invisible="1"/>
                    <field name="pdf_attachment_id" invisible="1"/>
                    <div class="alert alert-info" invisible="not pdf_legacy or pdf_sha256" role="status">No historical PDF is available. Reconstruction creates a new document dated today.</div>
                    <notebook>
                        <page string="Programme">
                            <group>
                                <field name="objectives" readonly="state != 'draft'"/>
                                <field name="target_audience" readonly="state != 'draft'"/>
                                <field name="prerequisites" readonly="state != 'draft'"/>
                            </group>
                            <separator string="Programme Content"/>
                            <field name="content_formatted" widget="html" readonly="state != 'draft'"/>
                            <group>
                                <field name="teaching_methods" readonly="state != 'draft'"/>
                                <field name="evaluation_criteria" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Access and Accessibility">
                            <group>
                                <field name="access_conditions" readonly="state != 'draft'"/>
                                <field name="accessibility_contact_id" readonly="state != 'draft'"/>
                                <field name="accessibility_information" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Public Information">
                            <group>
                                <field name="public_catalogue" readonly="state != 'draft'"/>
                                <field name="expected_outcomes" readonly="state != 'draft'"/>
                                <field name="practice_deliverables" readonly="state != 'draft'"/>
                                <field name="instructor_profiles" readonly="state != 'draft'"/>
                                <field name="material_access_duration" readonly="state != 'draft'"/>
                                <field name="included_services" readonly="state != 'draft'"/>
                                <field name="preparation_details" readonly="state != 'draft'"/>
                                <field name="mock_exam_details" readonly="state != 'draft'"/>
                                <field name="official_exam_details" readonly="state != 'draft'"/>
                                <field name="unconfirmed_information" readonly="state != 'draft'"/>
                                <field name="preview_filename" readonly="state != 'draft'"/>
                                <field name="preview_pdf" filename="preview_filename" readonly="state != 'draft'"/>
                            </group>
                            <p>Validation approves this extract and these questions for public publication. Never copy confidential content here.</p>
                            <field name="preview_question_ids" readonly="state != 'draft'">
                                <list editable="bottom"><field name="sequence"/><field name="name"/><field name="choice_a"/><field name="choice_b"/><field name="correct_choice"/><field name="explanation"/></list>
                            </field>
                        </page>
                        <page string="Validation History">
                            <group>
                                <field name="validated_by_id"/>
                                <field name="validated_at"/>
                                <field name="published_by_id"/>
                                <field name="published_at"/>
                                <field name="retired_by_id"/>
                                <field name="retired_at"/>
                                <field name="pdf_generated_by_id"/>
                                <field name="pdf_generated_at"/>
                                <field name="pdf_language_code"/>
                                <field name="pdf_reconstructed"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_training_program_search" model="ir.ui.view">
        <field name="name">training.program.version.search</field>
        <field name="model">training.program.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="course_id"/>
                <field name="version"/>
                <field name="category_id"/>
                <field name="delivery_mode"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="historical_pdf_missing" string="Historical PDF to Reconstruct" domain="[('pdf_legacy', '=', True), ('pdf_sha256', '=', False)]"/>
                <group>
                    <filter name="group_course" string="Standard Course" context="{'group_by': 'course_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_training_programs" model="ir.actions.act_window">
        <field name="name">Programme Versions</field>
        <field name="res_model">training.program.version</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_reconstruct_programme_pdf_selection" model="ir.actions.server">
        <field name="name">Reconstruct Historical PDF</field>
        <field name="model_id" ref="model_training_program_version"/>
        <field name="binding_model_id" ref="model_training_program_version"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('training_management.group_training_coordinator'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_reconstruct_pdf()</field>
    </record>
</odoo>
