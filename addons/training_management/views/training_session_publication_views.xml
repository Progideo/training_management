<odoo>
    <record id="view_session_publication_inspection_form" model="ir.ui.view">
        <field name="name">training.session.publication.inspection.form</field>
        <field name="model">training.session.publication.inspection</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <p>This private diagnostic does not publish the session, open registration or guarantee departure. Availability is checked at the server time shown below.</p>
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="delivery_id" readonly="1"/>
                    <field name="internal_state"/>
                    <field name="program_state"/>
                    <field name="catalogue_approved"/>
                    <field name="course_active"/>
                    <field name="dated_session"/>
                    <field name="start_at" invisible="not dated_session"/>
                    <field name="end_at" invisible="not dated_session"/>
                    <field name="timezone"/>
                    <field name="unlimited"/>
                    <field name="capacity" invisible="unlimited"/>
                    <field name="occupied_seats"/>
                    <field name="remaining_seats" invisible="unlimited"/>
                    <field name="checked_at"/>
                </group>
                <footer><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="action_inspect_session_availability" model="ir.actions.server">
        <field name="name">Session State and Availability</field>
        <field name="model_id" ref="model_training_delivery"/>
        <field name="binding_model_id" ref="model_training_delivery"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="state">code</field>
        <field name="code">action = record.action_inspect_session_availability()</field>
    </record>
    <record id="access_session_publication_inspection" model="ir.access">
        <field name="name">Private session publication preparation</field>
        <field name="model_id" ref="model_training_session_publication_inspection"/>
        <field name="group_id" ref="group_training_coordinator"/>
        <field name="operation">cru</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_session_publication_inspection_owner" model="ir.access">
        <field name="name">Session publication preparation owner</field>
        <field name="model_id" ref="model_training_session_publication_inspection"/>
        <field name="operation">crud</field>
        <field name="domain">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="view_delivery_public_session" model="ir.ui.view">
        <field name="name">training.delivery.public.session</field><field name="model">training.delivery</field>
        <field name="inherit_id" ref="view_training_delivery_form"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Public Session" groups="training_management.group_training_coordinator">
            <p>Publication, commercial opening and guaranteed departure require explicit decisions. No private client or participant information is published.</p>
            <group><field name="session_public"/><field name="session_sales_open"/><field name="session_first_published_at"/><field name="session_guaranteed"/></group>
            <button name="action_open_reason" type="object" string="Publish and Open Session" context="{'reason_action': 'action_publish_session'}" invisible="kind != 'session' or state not in ('preparation', 'confirmed') or (session_public and session_sales_open)"/>
            <button name="action_open_reason" type="object" string="Withdraw Public Session" context="{'reason_action': 'action_withdraw_session'}" invisible="not session_public"/>
            <button name="action_open_reason" type="object" string="Close Session Sales" context="{'reason_action': 'action_close_session_sales'}" invisible="not session_sales_open"/>
            <button name="action_open_reason" type="object" string="Guarantee Departure" context="{'reason_action': 'action_guarantee_session'}" invisible="session_guaranteed or kind != 'session' or state not in ('preparation', 'confirmed')"/>
            <button name="action_open_reason" type="object" string="Revoke Departure Guarantee" context="{'reason_action': 'action_revoke_session_guarantee'}" invisible="not session_guaranteed"/>
            <field name="session_alert_notice_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="recipient_id"/><field name="recipient_email"/><field name="distribution_state"/><field name="not_queued_reason"/></list></field>
        </page></xpath></field>
    </record>
    <record id="access_session_alert_subscription_coordinator" model="ir.access">
        <field name="name">Date alert subscription internal read</field><field name="model_id" ref="model_training_session_alert_subscription"/>
        <field name="group_id" ref="group_training_coordinator"/><field name="operation">r</field><field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_session_alert_event_coordinator" model="ir.access">
        <field name="name">Date alert event internal read</field><field name="model_id" ref="model_training_session_alert_event"/>
        <field name="group_id" ref="group_training_coordinator"/><field name="operation">r</field><field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_session_alert_notice_coordinator" model="ir.access">
        <field name="name">Date alert notice internal read</field><field name="model_id" ref="model_training_session_alert_notice"/>
        <field name="group_id" ref="group_training_coordinator"/><field name="operation">r</field><field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
