<odoo>
    <!-- Grouped actions of the enrollment list: one reason for the selection, one journal line per enrollment. -->
    <record id="action_enrollment_confirm_selection" model="ir.actions.act_window">
        <field name="name">Confirm Enrollment</field>
        <field name="res_model">training.action.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_name': 'action_confirm'}</field>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('training_management.group_training_coordinator'))]"/>
    </record>
    <record id="action_enrollment_authorize_selection" model="ir.actions.act_window">
        <field name="name">Authorize Commercially</field>
        <field name="res_model">training.action.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_name': 'action_authorize'}</field>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('training_management.group_training_coordinator'))]"/>
    </record>
    <record id="action_enrollment_open_access_selection" model="ir.actions.act_window">
        <field name="name">Open / Resume Access</field>
        <field name="res_model">training.action.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_name': 'action_open_access'}</field>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('training_management.group_training_coordinator'))]"/>
    </record>
    <record id="cron_training_expire" model="ir.cron">
        <field name="name">Training: record expired reservations and alert under-threshold sessions</field>
        <field name="model_id" ref="model_training_delivery"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="action_enrollment_postpone" model="ir.actions.server">
        <field name="name">Postpone</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'operation': 'postpone'}).action_open_operation()</field>
    </record>
    <record id="action_enrollment_replace" model="ir.actions.server">
        <field name="name">Replace Participant</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'operation': 'replace'}).action_open_operation()</field>
    </record>
    <record id="action_enrollment_waive_prerequisites" model="ir.actions.server">
        <field name="name">Waive Prerequisites</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_waive_prerequisites'}).action_open_reason()</field>
    </record>
    <record id="action_enrollment_withdraw_authorization" model="ir.actions.server">
        <field name="name">Withdraw Authorization</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_revoke_authorization'}).action_open_reason()</field>
    </record>
    <record id="action_enrollment_suspend_access" model="ir.actions.server">
        <field name="name">Suspend Access</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_suspend_access'}).action_open_reason()</field>
    </record>
    <record id="action_enrollment_revoke_access" model="ir.actions.server">
        <field name="name">Revoke Access</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_revoke_access'}).action_open_reason()</field>
    </record>
    <record id="action_enrollment_close" model="ir.actions.server">
        <field name="name">Close</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_close'}).action_open_reason()</field>
    </record>
    <record id="action_enrollment_abandon" model="ir.actions.server">
        <field name="name">Abandon</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_abandon'}).action_open_reason()</field>
    </record>
    <record id="action_enrollment_cancel" model="ir.actions.server">
        <field name="name">Cancel Enrollment</field>
        <field name="state">code</field>
        <field name="binding_view_types">form</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="code">action = record.with_context({'reason_action': 'action_cancel'}).action_open_reason()</field>
    </record>
</odoo>
