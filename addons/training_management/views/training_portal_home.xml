<odoo>
    <template id="portal_participant_home" inherit_id="portal.portal_my_home" name="Participant Training">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><div class="card p-3 my-2"><a href="/my/trainings">My training</a></div></xpath>
    </template>
    <template id="portal_trainings" name="My Training">
        <t t-call="portal.portal_layout" additional_title.translate="My training"><h1>My training</h1>
            <h2 t-if="enrollments">My enrollments</h2>
            <p t-if="not enrollments and not any(training_links.values())">No training is currently available. Contact your coordinator if needed.</p>
            <ul class="list-group"><li t-foreach="enrollments" t-as="enrollment" class="list-group-item">
                <a t-att-href="'/my/trainings/%s' % enrollment['id']" t-out="enrollment['name']"/><div t-out="enrollment['programme']"/>
            </li></ul><t t-call="portal.pager"/>
            <section class="my-4" t-if="any(training_links.get(k) for k in ('paths', 'practice', 'evaluations', 'documents', 'exams', 'feedback', 'bookings', 'publications', 'complaints'))">
                <h2>My actions and history</h2><div id="training_personal_links" class="tm_navigation"/>
            </section>
            <section class="my-4" t-if="any(training_links.get(k) for k in ('sessions', 'tutoring', 'dashboard', 'company'))">
                <h2>My responsibilities</h2><div id="training_responsibility_links" class="tm_navigation"/>
            </section>
        </t>
    </template>
</odoo>
