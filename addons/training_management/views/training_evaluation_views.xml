<odoo>
    <record id="menu_training_root" model="ir.ui.menu"><field name="group_ids" eval="[(4, ref('group_training_supervisor'))]"/></record>
    <record id="view_evaluation_list" model="ir.ui.view"><field name="name">training.evaluation.list</field><field name="model">training.evaluation</field><field name="arch" type="xml"><list><field name="name"/><field name="purpose"/><field name="program_id"/><field name="version"/><field name="state"/></list></field></record>
    <record id="view_evaluation_form" model="ir.ui.view"><field name="name">training.evaluation.form</field><field name="model">training.evaluation</field><field name="arch" type="xml">
        <form delete="false"><header><button name="action_publish" type="object" string="Publish Evaluation" invisible="state != 'draft'" groups="training_management.group_training_coordinator"/><button name="action_new_version" type="object" string="New Version" invisible="state != 'published'" groups="training_management.group_training_coordinator"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state == 'published'"/><field name="program_id" readonly="state == 'published'"/><field name="purpose" readonly="state == 'published'"/><field name="version" readonly="state == 'published'"/><field name="previous_id"/><field name="criteria" readonly="state == 'published'"/><field name="scored" readonly="state == 'published'"/><field name="threshold" invisible="not scored" readonly="state == 'published'"/><field name="published_at"/><field name="published_by_id"/></group></sheet></form>
    </field></record>
    <record id="view_evaluation_assignment_list" model="ir.ui.view"><field name="name">training.evaluation.assignment.list</field><field name="model">training.evaluation.assignment</field><field name="arch" type="xml"><list delete="false"><field name="name"/><field name="purpose"/><field name="state"/><field name="due_at"/><field name="result_available"/><field name="score" invisible="not result_available"/><field name="threshold" invisible="not result_available"/></list></field></record>
    <record id="view_evaluation_assignment_form" model="ir.ui.view"><field name="name">training.evaluation.assignment.form</field><field name="model">training.evaluation.assignment</field><field name="arch" type="xml"><form duplicate="false" delete="false"><header><button name="action_record" type="object" string="Validate / Revise Result" groups="training_management.group_training_coordinator,training_management.group_training_quality"/><button name="action_export_proof" type="object" string="Create Closure Evidence" invisible="state != 'validated'" groups="training_management.group_training_coordinator,training_management.group_training_quality"/><field name="state" widget="statusbar"/></header><sheet><group><field name="evaluation_id" options="{'no_open': True}" readonly="id"/><field name="enrollment_id" options="{'no_open': True}" readonly="id"/><field name="opens_at" readonly="id"/><field name="due_at" readonly="id"/><field name="attempt_number"/><field name="result_available"/><field name="score" invisible="not result_available"/><field name="threshold" invisible="not result_available"/><field name="revision"/></group><p role="status" invisible="state != 'validated' or result_available">Qualitative result (score not applicable).</p><p role="status" invisible="state == 'validated'">Not evaluated.</p><field name="result_ids" groups="training_management.group_training_coordinator,training_management.group_training_quality" readonly="1"><list create="false" delete="false"><field name="kind"/><field name="attempt_number"/><field name="score"/><field name="conclusion"/><field name="author_id"/><field name="create_date"/></list></field></sheet></form></field></record>
    <record id="view_evaluation_authorization_form" model="ir.ui.view"><field name="name">training.evaluation.authorization.form</field><field name="model">training.evaluation.authorization</field><field name="arch" type="xml"><form delete="false" duplicate="false"><sheet><group><field name="delivery_id" options="{'no_open': True}" readonly="id"/><field name="user_id" readonly="id"/><field name="purpose" readonly="id"/><field name="valid_from" readonly="id"/><field name="valid_until" readonly="id"/><field name="reason" readonly="id"/><field name="active"/></group></sheet></form></field></record>
    <record id="view_evaluation_record_form" model="ir.ui.view"><field name="name">training.evaluation.record.form</field><field name="model">training.evaluation.record</field><field name="arch" type="xml"><form><group><field name="assignment_id" readonly="1"/><field name="revision" readonly="1"/><field name="score"/><field name="score_confirmed"/><field name="conclusion"/><field name="source"/><field name="reason"/></group><footer><button name="action_apply" type="object" string="Validate Evaluation" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_delivery_evaluation" model="ir.ui.view"><field name="name">training.delivery.evaluation</field><field name="model">training.delivery</field><field name="inherit_id" ref="view_training_delivery_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Evaluation Roles" groups="training_management.group_training_coordinator"><field name="evaluation_supervisor_ids" widget="many2many_tags"/><field name="evaluation_instructor_ids" widget="many2many_tags"/><field name="evaluation_quality_id"/></group></xpath></field></record>
    <record id="action_evaluation" model="ir.actions.act_window"><field name="name">Evaluation Versions</field><field name="res_model">training.evaluation</field><field name="view_mode">list,form</field></record>
    <record id="action_evaluation_assignment" model="ir.actions.act_window"><field name="name">Assigned Evaluations</field><field name="res_model">training.evaluation.assignment</field><field name="view_mode">list,form</field></record>
    <record id="action_evaluation_authorization" model="ir.actions.act_window"><field name="name">Evaluation Authorizations</field><field name="res_model">training.evaluation.authorization</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_evaluation" name="Evaluation Versions" parent="menu_training_configuration" action="action_evaluation" groups="training_management.group_training_coordinator" sequence="10"/>
    <menuitem id="menu_evaluation_assignment" name="Assigned Evaluations" parent="menu_training_pedagogy" action="action_evaluation_assignment" groups="training_management.group_training_coordinator,training_management.group_training_quality,training_management.group_training_supervisor" sequence="20"/>
    <menuitem id="menu_evaluation_authorization" name="Evaluation Authorizations" parent="menu_training_configuration" action="action_evaluation_authorization" groups="training_management.group_training_quality" sequence="60"/>
    <template id="portal_evaluations_link" inherit_id="training_management.portal_trainings" name="Training Evaluations"><xpath expr="//div[@id='training_personal_links']" position="inside"><t t-if="training_links.get('evaluations')"><a href="/my/training-evaluations" class="btn btn-outline-primary">My training evaluations</a></t></xpath></template>
    <template id="portal_evaluations" name="Training Evaluations"><t t-call="portal.portal_layout"><t t-call="training_management.portal_training_navigation"/><h1>Training evaluations</h1><p t-if="not rows">No authorized evaluation.</p><ul><li t-foreach="rows" t-as="row"><a t-att-href="'/my/training-evaluations/%s' % row['id']" t-out="row['name']"/> — <span t-out="row['state']"/> — <span t-out="row['due']"/><span t-if="row['has_score']"> — <t t-out="row['score']"/> %</span><span t-elif="row['validated']"> — Qualitative result (score not applicable)</span><span t-else=""> — Not evaluated</span></li></ul><t t-call="portal.pager"/></t></template>
    <template id="portal_evaluation" name="Training Evaluation">
        <t t-call="portal.portal_layout">
            <t t-call="training_management.portal_training_navigation"/><a href="/my/training-evaluations">My evaluations</a>
            <h1 t-out="name"/>
            <p><span t-out="purpose"/> — Version <span t-out="version"/> — Attempt <span t-out="attempt_number"/></p>
            <p t-out="criteria"/>
            <p>State: <span t-out="state"/>. Deadline: <span t-out="due"/></p>
            <div t-if="error or message" id="evaluation-feedback" tabindex="-1" autofocus="autofocus" t-att-class="'alert alert-danger' if error else 'alert alert-success'" t-att-role="'alert' if error else 'status'" t-out="error or message"/>
            <p t-if="has_score">Validated score: <span t-out="score"/> % — Threshold: <span t-out="threshold"/> %</p>
            <p t-elif="validated">Qualitative result (score not applicable).</p>
            <p t-else="">Not evaluated.</p>
            <p t-if="conclusion" t-out="conclusion"/>
            <form t-if="own and not submitted" method="post" t-att-action="'/my/training-evaluations/%s#evaluation-feedback' % row_id">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="attempt_number" t-att-value="attempt_number"/>
                <button t-if="not started" name="operation" value="start" class="btn btn-primary">Start evaluation</button>
                <t t-else="">
                    <p t-if="not online">Complete the observed assessment according to your trainer's instructions.</p>
                    <fieldset t-foreach="questions" t-as="q" class="border p-3 mb-3">
                        <legend t-out="q['title']"/>
                        <t t-if="q['type'] in ('simple_choice', 'multiple_choice')">
                            <label t-foreach="q['choices']" t-as="choice" class="d-block">
                                <input t-att-type="'radio' if q['type'] == 'simple_choice' else 'checkbox'" t-att-name="'q_%s' % q['id']" t-att-value="choice['id']" t-att-checked="choice['selected']"/>
                                <span t-out="choice['label']"/>
                            </label>
                        </t>
                        <textarea t-else="" t-att-name="'q_%s' % q['id']" t-att-aria-label="q['title']" t-out="q['text']" class="form-control" maxlength="20000" rows="4"/>
                    </fieldset>
                    <div class="d-flex flex-column flex-sm-row gap-2 mb-3">
                        <button t-if="online" name="operation" value="save" class="btn btn-secondary">Save answers</button>
                        <button name="operation" value="submit" class="btn btn-primary">Submit final answers</button>
                    </div>
                </t>
            </form>
            <section t-if="history">
                <h2>Validated result history</h2>
                <ul><li t-foreach="history" t-as="item">Attempt <t t-out="item['attempt']"/> — <t t-out="item['date']"/> : <span t-if="item['scored']"><t t-out="item['score']"/> % — </span><span t-out="item['conclusion']"/></li></ul>
            </section>
            <section t-if="can_evaluate">
                <h2>Pedagogical validation</h2>
                <p t-foreach="review_answers" t-as="answer"><strong t-out="answer['question']"/> : <span t-out="answer['answer']"/></p>
                <form method="post" t-att-action="'/my/training-evaluations/%s#evaluation-feedback' % row_id">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="revision" t-att-value="revision"/>
                    <label t-if="scored" class="d-block mb-3">Score (%)<input class="form-control" type="number" name="score" min="0" max="100" step="any" required="required" t-att-value="form_values.get('score', proposed_score)"/></label>
                    <label class="d-block mb-3">Conclusion<textarea class="form-control" name="conclusion" required="required" t-out="form_values.get('conclusion', '')"/></label>
                    <label class="d-block mb-3">Source / observed evidence<textarea class="form-control" name="source" required="required" t-out="form_values.get('source', '')"/></label>
                    <label class="d-block mb-3">Reason / revision<textarea class="form-control" name="reason" required="required" t-out="form_values.get('reason', '')"/></label>
                    <button name="operation" value="validate" class="btn btn-primary mb-3">Validate / revise result</button>
                </form>
            </section>
            <form t-if="can_reopen and submitted" method="post" t-att-action="'/my/training-evaluations/%s#evaluation-feedback' % row_id">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="revision" t-att-value="revision"/>
                <label class="d-block mb-3">New deadline (<t t-out="timezone"/>)<input class="form-control" name="due_at_local" type="datetime-local" required="required" t-att-value="form_values.get('due_at_local', '')"/></label>
                <label class="d-block mb-3">Reason<textarea class="form-control" name="reason" required="required" t-out="form_values.get('reason', '')"/></label>
                <button name="operation" value="reopen" class="btn btn-secondary mb-3">Authorize a new attempt</button>
            </form>
        </t>
    </template>
</odoo>
