<odoo>
    <record id="company_form_training_notifications" model="ir.ui.view">
        <field name="name">res.company.form.training.notifications</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Training Notifications" groups="base.group_system">
                    <group>
                        <field name="training_notification_address"/>
                        <field name="training_notification_manager_id"/>
                        <field name="training_alert_address"/>
                        <field name="training_session_alert_retention_id" domain="[('company_id', '=', id), ('approved_at', '!=', False)]"/>
                    </group>
                    <p>Configure the sender and reply address only. This does not activate email transport. Existing queued messages are not rewritten.</p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
