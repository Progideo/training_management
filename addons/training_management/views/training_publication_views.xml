<odoo>
    <record id="view_publication_inspection_form" model="ir.ui.view">
        <field name="name">training.publication.inspection.form</field>
        <field name="model">training.publication.inspection</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <p>This private diagnostic does not authorize an invitation or publication. Enrollment and certificates do not replace current validated attendance. No consent is inferred.</p>
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="enrollment_id" readonly="1"/>
                    <field name="participant_id"/>
                    <field name="enrollment_state"/>
                    <field name="validated_minutes"/>
                    <field name="attendance_count"/>
                    <field name="certificate_count"/>
                    <field name="checked_at"/>
                </group>
                <footer><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="action_inspect_publication_evidence" model="ir.actions.server">
        <field name="name">Participation Evidence for a Review</field>
        <field name="model_id" ref="model_training_enrollment"/>
        <field name="binding_model_id" ref="model_training_enrollment"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('group_training_coordinator'))]"/>
        <field name="state">code</field>
        <field name="code">action = record.action_inspect_publication_evidence()</field>
    </record>
    <record id="access_publication_inspection" model="ir.access">
        <field name="name">Private publication preparation</field>
        <field name="model_id" ref="model_training_publication_inspection"/>
        <field name="group_id" ref="group_training_coordinator"/>
        <field name="operation">cru</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_publication_inspection_owner" model="ir.access">
        <field name="name">Publication preparation owner</field>
        <field name="model_id" ref="model_training_publication_inspection"/>
        <field name="operation">crud</field>
        <field name="domain">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="view_publication_list" model="ir.ui.view">
        <field name="name">training.publication.list</field><field name="model">training.publication</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="kind"/><field name="delivery_id"/><field name="state"/><field name="consented_at"/><field name="published_at"/></list></field>
    </record>
    <record id="view_publication_form" model="ir.ui.view">
        <field name="name">training.publication.form</field><field name="model">training.publication</field>
        <field name="arch" type="xml"><form>
            <header>
                <button name="action_request_authorization" type="object" string="Request Authorization" class="btn-primary" invisible="state != 'draft'" groups="group_training_coordinator"/>
                <button name="action_publish" type="object" string="Moderate and Publish" class="btn-primary" invisible="state not in ('submitted', 'authorized')" groups="group_training_publication_moderator"/>
                <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted', 'authorized')" groups="group_training_publication_moderator"/>
                <button name="action_withdraw" type="object" string="Withdraw Publication" invisible="state == 'withdrawn'" groups="group_training_publication_moderator"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <h1><field name="name" readonly="state != 'draft'"/></h1>
                <p>Only the explicitly authorized version may be published. Private satisfaction surveys are never imported. Check third-party identities, confidentiality and the absence of individual results before moderation.</p>
                <group><group>
                    <field name="company_id" invisible="1"/>
                    <field name="kind" readonly="id"/>
                    <field name="delivery_id" readonly="id"/>
                    <field name="enrollment_id" invisible="kind != 'review'" required="kind == 'review'" readonly="id"/>
                    <field name="allocation_id" invisible="kind != 'case'" required="kind == 'case'" readonly="id"/>
                    <field name="representative_id" invisible="kind != 'case'" required="kind == 'case'" readonly="id"/>
                    <field name="authority_reference" invisible="kind != 'case'" readonly="id"/>
                    <field name="retention_id" readonly="id"/>
                </group><group>
                    <field name="owner_id"/>
                    <field name="confidential" invisible="kind != 'case'" readonly="state != 'draft'"/>
                    <field name="identify_client" invisible="kind != 'case'" readonly="state != 'draft'"/>
                    <field name="public_identity"/><field name="identity_mode"/><field name="identity_consented"/>
                    <field name="consented_at"/><field name="consented_by_id"/><field name="published_at"/><field name="moderated_by_id"/>
                </group></group>
                <group string="Exact Public Content">
                    <field name="public_context" readonly="state != 'draft' or kind == 'review'"/>
                    <field name="participation_month" readonly="state != 'draft' or kind == 'review'"/>
                    <field name="body" readonly="state != 'draft' or kind == 'review'"/>
                    <field name="consent_wording"/>
                </group>
                <group string="Moderation"><field name="moderation_reason" groups="group_training_publication_moderator"/></group>
                <field name="event_ids"><list create="0" edit="0" delete="0"><field name="occurred_at"/><field name="actor_id"/><field name="state"/><field name="reason"/></list></field>
            </sheet>
        </form></field>
    </record>
    <record id="action_publications" model="ir.actions.act_window"><field name="name">Verified Reviews and Customer Cases</field><field name="res_model">training.publication</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_publications" name="Reviews and Customer Cases" parent="menu_training_quality" action="action_publications" groups="group_training_coordinator,group_training_publication_moderator" sequence="80"/>
</odoo>
