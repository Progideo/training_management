<odoo>
    <template id="publication_home" name="Publication requests">
        <t t-call="portal.frontend_layout"><main class="container py-4">
            <h1>Publication requests</h1>
            <p>Giving an opinion or authorizing a customer case is optional. Private satisfaction surveys remain separate.</p>
            <p t-if="not rows">No publication request.</p>
            <ul><li t-foreach="rows" t-as="r"><a t-att-href="'/my/training-publications/%s' % r['id']" t-out="r['context']"/> — <span t-out="r['state']"/></li></ul>
        </main></t>
    </template>
    <template id="publication_form" name="Exact publication authorization">
        <t t-call="portal.frontend_layout"><main class="container py-4" style="max-width:50rem">
            <a href="/my/training-publications">Publication requests</a>
            <h1>Publication authorization</h1>
            <p t-out="row['state']"/>
            <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
            <h2>Public context</h2><p t-out="row['context']"/>
            <p><span>Participation month:</span> <span t-out="row['month']"/>. <span>Verified participation may be partial; it does not certify completion or success.</span></p>
            <p t-if="not row['can_consent']" style="white-space:pre-wrap" t-out="row['body']"/>
            <form t-if="row['can_consent']" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="operation" value="consent"/>
                <input type="hidden" name="definition" t-att-value="row['definition']"/>
                <div t-if="row['kind'] == 'review'" class="mb-3">
                    <label for="opinion">Your exact public opinion</label>
                    <textarea id="opinion" name="body" class="form-control" rows="7" maxlength="5000" required="required" t-out="row['body'] or ''"/>
                    <fieldset class="mt-3"><legend>Public identity</legend>
                        <label class="d-block"><input type="radio" name="identity" value="anonymous" checked="checked"/> Verified participant</label>
                        <label class="d-block"><input type="radio" name="identity" value="name"/> <span>Exact name:</span> <strong t-out="row['name']"/></label>
                    </fieldset>
                    <label class="d-block mt-2"><input type="checkbox" name="identity_accepted" value="yes"/> I separately authorize display of this exact name if I select it.</label>
                </div>
                <div t-else="" class="mb-3">
                    <h2>Exact customer case</h2><p style="white-space:pre-wrap" t-out="row['body']"/>
                    <input type="hidden" name="identity" t-att-value="'name' if row['identify_client'] else 'anonymous'"/>
                    <label t-if="row['identify_client']" class="d-block"><input type="checkbox" name="identity_accepted" value="yes"/> <span>I separately authorize display of this exact customer name:</span> <strong t-out="row['name']"/></label>
                </div>
                <p t-out="row['terms']"/>
                <label class="d-block mb-3"><input type="checkbox" name="accepted" value="yes" required="required"/> I authorize this exact version under the displayed terms.</label>
                <button type="submit" class="btn btn-primary">Authorize for moderation</button>
            </form>
            <form t-if="row['can_withdraw']" method="post" class="mt-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="operation" value="withdraw"/>
                <button type="submit" class="btn btn-outline-danger">Withdraw my publication authorization</button>
            </form>
            <p class="mt-3">Withdrawal removes the publication from this catalogue. Copies made by third parties cannot be recalled. Contact coordination for a deletion request.</p>
        </main></t>
    </template>
    <template id="publication_public" name="Verified reviews and customer cases">
        <t t-call="portal.frontend_layout"><main class="container py-4">
            <a t-att-href="'/formations/%s' % program_id">Back to programme</a>
            <h1>Verified reviews and customer cases</h1><h2 t-out="title"/>
            <p>Participant reviews require verified participation, explicit consent and moderation. Participation may be partial; an opinion is not a certificate or a satisfaction rate.</p>
            <p t-if="not rows">No authorized publication available.</p>
            <article t-foreach="rows" t-as="r" class="border rounded p-3 mb-3">
                <h3 t-out="r['identity']"/><p t-out="r['context']"/>
                <p><span>Participation month:</span> <span t-out="r['month']"/> — <span>Authorized on:</span> <time t-att-datetime="r['date']" t-out="r['date']"/></p>
                <p style="white-space:pre-wrap" t-out="r['body']"/>
            </article>
        </main></t>
    </template>
    <template id="public_programme_publications" inherit_id="training_management.public_programme">
        <xpath expr="//h1" position="after"><p><a t-att-href="'/formations/%s/avis' % program['id']">Verified reviews and customer cases</a></p></xpath>
    </template>
    <template id="portal_publications_link" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <p><a href="/my/training-publications">Publication requests</a></p>
        </xpath>
    </template>
</odoo>
