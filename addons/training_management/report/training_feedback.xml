<odoo>
    <record id="report_feedback" model="ir.actions.report"><field name="name">Feedback Campaign Summary</field><field name="model">training.feedback.campaign</field><field name="report_type">qweb-pdf</field><field name="report_name">training_management.feedback_document</field><field name="paperformat_id" ref="paperformat_programme_pdf"/><field name="group_ids" eval="[(4, ref('group_training_coordinator')), (4, ref('group_training_quality'))]"/></record>
    <template id="feedback_document"><html><head><meta charset="utf-8"/></head><body style="font-family: DejaVu Sans, sans-serif;">
        <section t-foreach="rows" t-as="row"><h1 t-out="row['name']"/><p t-out="row['summary']"/><t t-if="row['snapshot']"><t t-set="s" t-value="row['snapshot']"/><p>Version <t t-out="s['version']"/> — <t t-out="s['opens_at']"/> — <t t-out="s['due_at']"/></p><p t-out="s['population']"/><p t-if="'valid' in s">Favorable / valid: <t t-out="s['favorable']"/> / <t t-out="s['valid']"/></p><section t-foreach="s['questions']" t-as="q"><h2 t-out="q['title']"/><p>Valid responses: <t t-out="q['valid']"/></p><p t-foreach="q['choices']" t-as="c"><t t-out="c['label']"/> : <t t-out="c['count']"/></p></section></t><p>S092-QWEB-1</p></section>
    </body></html></template>
    <record id="view_feedback_export" model="ir.ui.view"><field name="name">training.feedback.export.form</field><field name="model">training.feedback.export</field><field name="arch" type="xml"><form><group><field name="campaign_id"/><field name="dossier_id"/></group><footer><button name="action_export" type="object" string="Create S08 Evidence" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
</odoo>
