<odoo>
    <record id="report_evaluation" model="ir.actions.report"><field name="name">Dedicated Evaluation Evidence</field><field name="model">training.evaluation.result</field><field name="report_type">qweb-pdf</field><field name="report_name">training_management.evaluation_document</field><field name="paperformat_id" ref="paperformat_programme_pdf"/><field name="group_ids" eval="[(4, ref('group_training_coordinator')), (4, ref('group_training_quality'))]"/></record>
    <template id="evaluation_document"><html><head><meta charset="utf-8"/></head><body style="font-family: DejaVu Sans, sans-serif;">
        <section t-foreach="docs" t-as="doc"><h1>Évaluation pédagogique dédiée</h1><p t-out="doc.assignment_id.name"/><p>Finalité : <span t-out="purpose_labels[doc.assignment_id.evaluation_id.purpose]"/> — Version : <span t-out="doc.assignment_id.evaluation_id.version"/></p><p>Critères : <span t-out="doc.assignment_id.evaluation_id.criteria"/></p><p>Tentative : <span t-out="doc.attempt_number"/> — Décision : <span t-out="doc.id"/></p><p t-if="doc.assignment_id.evaluation_id.scored">Score : <span t-out="doc.score"/> % — Seuil : <span t-out="doc.assignment_id.threshold"/> %</p><p t-out="doc.conclusion"/><p>Source : <span t-out="doc.source"/></p><p>Motif : <span t-out="doc.reason"/></p><p>Évaluateur : <span t-out="doc.author_id.name"/> — Date serveur (UTC) : <span t-out="doc.create_date"/></p><p>Modèle S091-QWEB-1. Ne constitue pas une certification officielle.</p></section>
    </body></html></template>
</odoo>
