<odoo>
    <record id="privilege_training" model="res.groups.privilege">
        <field name="name">Training Management</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_training_reader" model="res.groups">
        <field name="name">Catalogue Reader</field>
        <field name="privilege_id" ref="privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_training_coordinator" model="res.groups">
        <field name="name">Training Coordinator</field>
        <field name="privilege_id" ref="privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('group_training_reader'))]"/>
    </record>
</odoo>
