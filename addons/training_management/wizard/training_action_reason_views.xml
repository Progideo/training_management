<odoo>
    <record id="view_training_action_reason" model="ir.ui.view">
        <field name="name">training.action.reason.form</field>
        <field name="model">training.action.reason</field>
        <field name="arch" type="xml">
            <form string="Reason for the Action">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_ids" invisible="1"/>
                    <field name="action_name" invisible="1"/>
                    <field name="action_label"/>
                    <field name="target_count"/>
                    <field name="reason_required" invisible="1"/>
                    <field name="reason" invisible="not reason_required" required="reason_required"/>
                </group>
                <group invisible="not conflict_description" string="Resource Exception" col="1">
                    <field name="conflict_description" nolabel="1" force_save="1"/>
                    <label for="conflict_reason"/>
                    <field name="conflict_reason" nolabel="1" required="conflict_description"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" invisible="conflict_description"/>
                    <button name="action_apply" type="object" string="Confirm with Exception" class="btn-primary" invisible="not conflict_description"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
