<odoo>
    <record id="view_training_certificate_change" model="ir.ui.view">
        <field name="name">training.certificate.change.form</field>
        <field name="model">training.certificate.change</field>
        <field name="arch" type="xml">
            <form string="Change Certificate Status">
                <group><field name="verification_id"/><field name="state"/><field name="dossier_id" invisible="1"/><field name="kind" invisible="1"/>
                    <field name="replacement_id" invisible="state != 'replaced'" required="state == 'replaced'"/>
                    <field name="reason"/>
                </group>
                <footer><button name="action_apply" type="object" string="Apply" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
            </form>
        </field>
    </record>
</odoo>
