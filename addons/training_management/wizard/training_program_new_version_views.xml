<odoo>
    <record id="view_training_program_new_version_form" model="ir.ui.view">
        <field name="name">training.program.new.version.form</field>
        <field name="model">training.program.new.version</field>
        <field name="arch" type="xml">
            <form string="New Programme Version">
                <group>
                    <field name="source_id" options="{'no_open': True}"/>
                    <field name="version"/>
                </group>
                <p>The new draft keeps the source content and its translations.</p>
                <footer>
                    <button name="action_create_version" type="object" string="Create Draft" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
