<odoo>
    <record id="import_form" model="ir.ui.view">
        <field name="name">training.interactive.import.form</field><field name="model">training.elearning.import</field>
        <field name="arch" type="xml"><form string="Importer un paquet"><group>
            <field name="resource_id"/><field name="number"/><field name="filename" invisible="1"/>
            <field name="data" filename="filename"/><field name="license_note"/><field name="provenance"/>
        </group><footer><button name="action_import" type="object" string="Contrôler et importer" class="btn-primary"/>
            <button special="cancel" string="Annuler"/></footer></form></field>
    </record>
    <record id="import_action" model="ir.actions.act_window">
        <field name="name">Importer une version</field><field name="res_model">training.elearning.import</field>
        <field name="view_mode">form</field><field name="view_id" ref="import_form"/><field name="target">new</field>
    </record>
    <record id="withdraw_form" model="ir.ui.view">
        <field name="name">training.interactive.withdraw.form</field><field name="model">training.elearning.withdraw</field>
        <field name="arch" type="xml"><form string="Retrait de sécurité"><group>
            <field name="version_id"/><field name="reason"/>
        </group><footer><button name="action_withdraw" type="object" string="Retirer la version" class="btn-primary"/>
            <button special="cancel" string="Annuler"/></footer></form></field>
    </record>
    <record id="withdraw_action" model="ir.actions.act_window">
        <field name="name">Retrait de sécurité</field><field name="res_model">training.elearning.withdraw</field>
        <field name="view_mode">form</field><field name="view_id" ref="withdraw_form"/><field name="target">new</field>
    </record>
    <record id="version_form" model="ir.ui.view">
        <field name="name">training.interactive.version.form</field><field name="model">training.elearning.version</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><header>
            <button name="action_preview" type="object" string="Prévisualiser" invisible="state == 'withdrawn'"/>
            <button name="action_publish" type="object" string="Publier" invisible="state != 'draft'" groups="training_interactive.group_interactive_author"/>
            <button name="%(withdraw_action)d" type="action" string="Retirer pour sécurité" context="{'default_version_id': id}"
                    groups="training_interactive.group_interactive_manager" invisible="state == 'withdrawn'"/>
            <field name="state" widget="statusbar"/>
        </header><sheet><group>
            <field name="resource_id"/><field name="number"/><field name="sha256"/><field name="entrypoint"/>
            <field name="license_note"/><field name="provenance"/>
            <field name="published_at"/><field name="published_by_id"/>
            <field name="withdrawn_at" invisible="not withdrawn_at"/><field name="withdrawn_by_id" invisible="not withdrawn_by_id"/>
            <field name="withdrawal_reason" invisible="not withdrawal_reason"/>
        </group></sheet></form></field>
    </record>
    <record id="resource_list" model="ir.ui.view">
        <field name="name">training.interactive.resource.list</field><field name="model">training.elearning.resource</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="format"/>
            <field name="company_id" groups="base.group_multi_company"/><field name="active"/></list></field>
    </record>
    <record id="resource_form" model="ir.ui.view">
        <field name="name">training.interactive.resource.form</field><field name="model">training.elearning.resource</field>
        <field name="arch" type="xml"><form><header>
            <button name="%(import_action)d" type="action" string="Importer une version" context="{'default_resource_id': id}" invisible="not id or not active"/>
        </header><sheet><group>
            <group colspan="2">
                <field name="name"/><field name="identifier"/><field name="format" readonly="id"/>
                <field name="company_id" readonly="id" groups="base.group_multi_company"/><field name="active"/>
            </group>
            <!-- Persistent titles avoid labels targeting the dialog's similarly named inputs. -->
            <group string="Content license" colspan="2" col="1">
                <field name="license_note" nolabel="1" placeholder="Content license"/>
            </group>
            <group string="Provenance" colspan="2" col="1">
                <field name="provenance" nolabel="1" placeholder="Provenance"/>
            </group>
        </group><field name="version_ids" readonly="1" context="{'form_view_ref': 'training_interactive.version_form'}">
            <list create="0" delete="0"><field name="number"/><field name="state"/><field name="published_at"/></list>
        </field></sheet></form></field>
    </record>
    <record id="resource_action" model="ir.actions.act_window">
        <field name="name">Ressources interactives</field><field name="res_model">training.elearning.resource</field>
        <field name="view_mode">list,form</field><field name="view_ids" eval="[
            (5, 0, 0), (0, 0, {'view_mode':'list', 'view_id': ref('resource_list')}),
            (0, 0, {'view_mode':'form', 'view_id': ref('resource_form')})]"/>
    </record>
    <menuitem id="resource_menu" name="Ressources interactives" parent="training_catalog.menu_catalog_root"
              action="resource_action" groups="training_interactive.group_interactive_author" sequence="90"/>
</odoo>
