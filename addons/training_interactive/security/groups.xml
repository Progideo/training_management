<odoo>
    <record id="privilege_interactive" model="res.groups.privilege">
        <field name="name">Interactive Resources</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_interactive_author" model="res.groups">
        <field name="name">Interactive Content Author</field>
        <field name="privilege_id" ref="privilege_interactive"/>
        <field name="implied_ids" eval="[(4, ref('training_catalog.group_catalog_reader'))]"/>
    </record>
    <record id="group_interactive_manager" model="res.groups">
        <field name="name">Interactive Library Manager</field>
        <field name="privilege_id" ref="privilege_interactive"/>
        <field name="implied_ids" eval="[(4, ref('group_interactive_author'))]"/>
    </record>
</odoo>
