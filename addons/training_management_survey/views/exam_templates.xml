<odoo>
    <template id="exam_home" inherit_id="portal.portal_my_home" name="My Mock Exams">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><div class="card p-3 my-2"><a href="/my/training-exams">My mock exam attempts</a></div></xpath>
    </template>
    <template id="exam_history" name="My Mock Exam Attempts">
        <t t-call="portal.portal_layout"><h1>My mock exam attempts</h1><p>Previous results remain available after access expiry. Suspension or revocation blocks access.</p>
        <p t-if="not attempts">No attempt yet.</p><ul><li t-foreach="attempts" t-as="a"><a t-att-href="'/my/training-exams/%s' % a['id']"><span t-out="a['title']"/> — <span t-out="a['date']"/></a></li></ul><t t-call="portal.pager"/></t>
    </template>
    <template id="learning_exam_link" inherit_id="training_management.portal_learning_content" name="Mock Exam Access">
        <xpath expr="//p[@t-if=&quot;a['criterion'] == 'evaluation'&quot;]" position="replace"><p t-if="a['criterion'] == 'evaluation' and not a['complete']">Complete the assigned mock exam to reach the required threshold.</p></xpath>
        <xpath expr="//section[1]" position="inside">
            <p t-foreach="learning['activities']" t-as="a" t-if="not is_tutor and a.get('exam_url')">
                <a class="btn btn-outline-primary" t-att-href="a['exam_url']">Mock exam: <t t-out="a['name']"/></a>
            </p>
        </xpath>
    </template>
    <template id="exam_start" name="Mock Exam Attempts">
        <t t-call="portal.portal_layout"><div class="container py-4">
            <a t-att-href="back">My training</a><h1 t-out="title"/>
            <p>Mock exam — no official certification.</p><p>Duration: <t t-out="duration"/> minutes. Time runs continuously after confirmation, including while disconnected.</p>
            <form t-if="can_start" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <button type="submit" class="btn btn-primary"><t t-if="has_active">Resume the active attempt</t><t t-elif="attempts">Confirm and retake the mock exam</t><t t-else="">Confirm and start the mock exam</t></button>
            </form>
            <p t-else="">New attempts require active access and completed prerequisites.</p>
            <h2 class="mt-4">My attempts</h2><p t-if="not attempts">No attempt yet.</p>
            <ul><li t-foreach="attempts" t-as="attempt"><a t-att-href="'/my/training-exams/%s' % attempt['id']"><span t-out="attempt['date']"/> — <t t-if="attempt['done']">Result and correction</t><t t-else="">Resume</t></a></li></ul>
        </div></t>
    </template>
    <!-- The native multiple-choice template colors a selected correct answer even
         with correction disabled. Override only that expression for this runner. -->
    <template id="exam_choice_image" inherit_id="survey.question_suggested_value_image" primary="True" name="Authorized Native Choice Image">
        <xpath expr="//div[@t-if]" position="attributes"><attribute name="t-if">True</attribute></xpath>
        <xpath expr="//div[@t-else]" position="replace"><t/></xpath>
    </template>
    <template id="exam_simple_choice" inherit_id="survey.question_simple_choice" primary="True" name="Private Native Single Choice">
        <xpath expr="//t[@t-call='survey.question_suggested_value_image']" position="attributes"><attribute name="t-call">training_management_survey.exam_choice_image</attribute></xpath>
    </template>
    <template id="exam_multiple_choice" inherit_id="survey.question_multiple_choice" primary="True" name="Private Native Multiple Choice">
        <xpath expr="//t[@t-set='answer_class']" position="attributes"><attribute name="t-value">''</attribute></xpath>
        <xpath expr="//t[@t-call='survey.question_suggested_value_image']" position="attributes"><attribute name="t-call">training_management_survey.exam_choice_image</attribute></xpath>
    </template>
    <template id="exam_attempt" name="Private Mock Exam">
        <t t-call="survey.layout"><div class="container py-4">
            <a t-att-href="back">My attempts / retake the mock exam</a><h1 t-out="survey.title"/>
            <p>Mock exam — no official certification.</p>
            <t t-if="result">
                <form t-if="can_retake" t-att-action="back" method="post" class="my-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <p>Retaking starts a new attempt with the full duration. Previous results are preserved.</p>
                    <button type="submit" class="btn btn-primary">Confirm and retake the mock exam</button>
                </form>
                <t t-call="training_management_survey.exam_result"/>
            </t>
            <t t-else="">
                <div class="o_training_exam" t-att-data-endpoint="'/my/training-exams/%s/save' % answer.id">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="o_survey_form_content_data d-none" t-att-data-server-time="server_time" t-att-data-timer="answer.start_datetime.isoformat()" t-att-data-time-limit-minutes="survey.time_limit"/>
                    <p class="o_survey_timer_container">Time remaining: <strong class="o_survey_timer" role="timer"/></p>
                    <p class="tm_save_status alert alert-info" role="status" aria-live="polite">Answers received by the server are saved. Unsaved changes will be reported here.</p>
                    <nav aria-label="Question palette" class="d-flex flex-wrap gap-2 mb-3">
                        <button t-foreach="answer.predefined_question_ids.sorted(lambda q: (q.sequence, q.id))" t-as="question" type="button" class="btn btn-outline-secondary tm_question_link" t-att-data-question="question.id"><t t-out="question_index + 1"/><span class="tm_question_state"/></button>
                    </nav>
                    <fieldset t-foreach="answer.predefined_question_ids.sorted(lambda q: (q.sequence, q.id))" t-as="question" class="tm_question border p-3 mb-3" t-att-data-question="question.id">
                        <legend class="h5" tabindex="-1"><span t-out="question_index + 1"/>. <t t-out="question.title"/></legend>
                        <div t-field="question.description"/>
                        <t t-set="answer_lines" t-value="answer.user_input_line_ids.filtered(lambda line: line.question_id == question)"/>
                        <t t-if="question.question_type == 'simple_choice'" t-call="training_management_survey.exam_simple_choice"/>
                        <t t-else="" t-call="training_management_survey.exam_multiple_choice"/>
                        <label class="mt-3 d-block"><input type="checkbox" class="tm_review form-check-input me-2" t-att-checked="question in answer.training_review_ids"/>Mark for review</label>
                        <button type="button" class="tm_clear btn btn-link">Clear answer</button>
                    </fieldset>
                    <div class="d-flex gap-2 my-3"><button type="button" class="tm_previous btn btn-outline-secondary">Previous</button><button type="button" class="tm_next btn btn-outline-secondary">Next</button><button type="button" class="tm_summary btn btn-secondary">Review and submit</button></div>
                    <div class="tm_recap card p-3" hidden="hidden"><h2>Submission summary</h2><p class="tm_recap_text"/>
                        <p>Submitting ends this attempt. Its answers cannot then be changed.</p><button type="button" class="tm_submit btn btn-primary">Confirm final submission</button>
                    </div>
                    <noscript><p class="alert alert-warning">JavaScript is required for answer saving and navigation. This attempt remains timed; reload after enabling JavaScript.</p></noscript>
                </div>
            </t>
        </div></t>
    </template>
    <template id="exam_result" name="Mock Exam Correction and Themes">
        <h2>Result and final correction</h2>
        <p><strong t-out="result['points']"/> / <span t-out="result['maximum']"/> — <strong t-out="round(result['percentage'], 2)"/> % · <t t-if="result['success']">Threshold reached</t><t t-else="">Threshold not reached</t></p>
        <p>This mock exam result does not guarantee success in an official exam.</p>
        <t t-if="result['revisions']"><p>Initial result preserved: <t t-out="round(result['original_percentage'], 2)"/> %.</p>
            <ul><li t-foreach="result['revisions']" t-as="revision"><span t-out="revision['date']"/>: <t t-out="revision['reason']"/></li></ul>
        </t>
        <h3>Results by theme</h3><table class="table"><thead><tr><th>Theme</th><th>Points</th><th>Score</th></tr></thead><tbody>
            <tr t-foreach="result['themes'].items()" t-as="theme"><th t-out="theme[0]"/><td><span t-out="theme[1]['points']"/> / <span t-out="theme[1]['maximum']"/></td><td><t t-if="theme[1]['maximum']"><span t-out="round(100 * theme[1]['points'] / theme[1]['maximum'], 2)"/> %</t><t t-else="">Not evaluated</t></td></tr>
        </tbody></table>
        <section t-foreach="result['questions']" t-as="q" class="card p-3 my-3">
            <h3 class="h5" t-out="q['title']"/><p>Your answers: <span t-out="', '.join(q['selected']) or '—'"/></p>
            <p>Expected answers: <span t-out="', '.join(q['correct'])"/></p><p><span t-out="q['points']"/> / <span t-out="q['maximum']"/></p>
            <p t-if="q['explanation']" t-out="q['explanation']"/><a t-if="q['url']" t-att-href="q['url']">Authorized revision resource</a>
        </section>
    </template>
</odoo>
