<odoo>
  <template id="exam_home" inherit_id="training_management.portal_trainings" name="My Mock Exams">
    <xpath expr="//div[@id='training_personal_links']" position="inside">
      <t t-if="training_links.get('exams')">
        <div class="card p-3 my-2">
          <a href="/my/training-exams">My mock exam attempts</a>
        </div>
      </t>
    </xpath>
  </template>
  <template id="exam_history" name="My Mock Exam Attempts">
    <t t-call="portal.portal_layout" additional_title.translate="My Mock Exam Attempts">
      <t t-call="training_management.portal_training_navigation" />
      <h1>My mock exam attempts</h1>
      <p>Previous results remain available after access expiry. Suspension or revocation blocks access.</p>
      <p t-if="not attempts">No attempt yet.</p>
      <ul>
        <li t-foreach="attempts" t-as="a">
          <a t-att-href="'/my/training-exams/%s' % a['id']">
            <span t-out="a['title']" /> — <span t-out="a['date']" />
          </a>
        </li>
      </ul>
      <t t-call="portal.pager" />
    </t>
  </template>
  <template id="learning_exam_link" inherit_id="training_management.portal_learning_content" name="Mock Exam Access">
    <xpath expr="//p[@t-if=&quot;a['criterion'] == 'evaluation'&quot;]" position="replace">
      <p t-if="a['criterion'] == 'evaluation' and not a['complete']">
        <t t-if="a.get('exam_obligation') == 'optional'">Optional exam: it does not block completion.</t>
        <t t-elif="a.get('exam_obligation') == 'complete'">Finish one attempt; an expired attempt also counts once closed.</t>
        <t t-else="">Reach the assigned exam version's success threshold.</t>
      </p>
    </xpath>
    <xpath expr="//section[1]" position="inside">
      <p t-foreach="learning['activities']" t-as="a" t-if="not is_tutor and a.get('exam_url')">
        <a class="btn btn-outline-primary" t-att-href="a['exam_url']">Mock exam: <t t-out="a['name']" />
        </a>
      </p>
    </xpath>
  </template>
  <template id="exam_start" name="Mock Exam Attempts">
    <t t-call="portal.portal_layout" additional_title.translate="Mock Exam Attempts">
      <t t-call="training_management.portal_training_navigation" />
      <div class="container py-4">
        <a t-att-href="back">My training</a>
        <h1 t-out="title" />
        <p>Mock exam — no official certification.</p>
        <p>Duration: <t t-out="duration" /> minutes. Time runs continuously after confirmation, including while disconnected.</p>
        <form t-if="can_start" method="post">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
          <button type="submit" class="btn btn-primary">
            <t t-if="has_active">Resume the active attempt</t>
            <t t-elif="attempts">Confirm and retake the mock exam</t>
            <t t-else="">Confirm and start the mock exam</t>
          </button>
        </form>
        <p t-else="">New attempts require active access and completed prerequisites.</p>
        <h2 class="mt-4">My attempts</h2>
        <p t-if="not attempts">No attempt yet.</p>
        <ul>
          <li t-foreach="attempts" t-as="attempt">
            <a t-att-href="'/my/training-exams/%s' % attempt['id']">
              <span t-out="attempt['date']" /> — <t t-if="attempt['done']">Result and correction</t>
              <t t-else="">Resume</t>
            </a>
          </li>
        </ul>
      </div>
    </t>
  </template>
  <template id="exam_choice_image" inherit_id="training_mock_exam.exam_choice_image" primary="True" name="TM exam_choice_image">
    <xpath expr="//img" position="attributes">
      <attribute name="t-att-src">'/survey/get_question_image/%s/%s/%s/%s' % (survey.access_token, answer.access_token, question.id, label.id)</attribute>
    </xpath>
  </template>
  <template id="exam_simple_choice" inherit_id="training_mock_exam.exam_simple_choice" primary="True" name="TM exam_simple_choice">
    <xpath expr="//t[@t-call='training_mock_exam.exam_choice_image']" position="attributes">
      <attribute name="t-call">training_management_survey.exam_choice_image</attribute>
    </xpath>
  </template>
  <template id="exam_multiple_choice" inherit_id="training_mock_exam.exam_multiple_choice" primary="True" name="TM exam_multiple_choice">
    <xpath expr="//t[@t-call='training_mock_exam.exam_choice_image']" position="attributes">
      <attribute name="t-call">training_management_survey.exam_choice_image</attribute>
    </xpath>
  </template>
  <template id="exam_attempt" inherit_id="training_mock_exam.exam_attempt" primary="True" name="TM exam_attempt">
    <xpath expr="//div[@class='o_training_exam']" position="attributes">
      <attribute name="t-att-data-endpoint">'/my/training-exams/%s/save' % answer.id</attribute>
    </xpath>
    <xpath expr="//t[@t-call='training_mock_exam.exam_simple_choice']" position="attributes">
      <attribute name="t-call">training_management_survey.exam_simple_choice</attribute>
    </xpath>
    <xpath expr="//t[@t-call='training_mock_exam.exam_multiple_choice']" position="attributes">
      <attribute name="t-call">training_management_survey.exam_multiple_choice</attribute>
    </xpath>
    <xpath expr="//t[@t-call='training_mock_exam.exam_result']" position="attributes">
      <attribute name="t-call">training_management_survey.exam_result</attribute>
    </xpath>
  </template>
  <template id="exam_result" name="TM mock exam correction">
    <t t-call="training_mock_exam.exam_result" />
  </template>
</odoo>