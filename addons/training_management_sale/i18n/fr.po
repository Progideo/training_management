#. module: training_management_sale
#: code:addons/training_management_sale/models/product_template.py:0
msgid "A training commercial product must be a service with a price basis."
msgstr "Un produit commercial de formation doit être un service avec une base tarifaire."

#. module: training_management_sale
#: code:addons/training_management_sale/models/product_template.py:0
msgid "Choose a training catalogue entry for this price basis."
msgstr "Choisissez une formation du catalogue pour cette base tarifaire."

#. module: training_management_sale
#: code:addons/training_management_sale/models/crm_lead.py:0
msgid "Choose a validated or published programme before creating a training quotation."
msgstr "Choisissez un programme validé ou publié avant de créer un devis de formation."

#. module: training_management_sale
#: code:addons/training_management_sale/models/crm_lead.py:0
msgid "Enter a positive participant count and requested currency."
msgstr "Indiquez un nombre positif de participants et la devise demandée."

#. module: training_management_sale
#: code:addons/training_management_sale/models/crm_lead.py:0
msgid "Training quotations use MAD or EUR."
msgstr "Les devis de formation utilisent le MAD ou l’EUR."

#. module: training_management_sale
#: code:addons/training_management_sale/models/crm_lead.py:0
msgid "Expected participants cannot be negative."
msgstr "Le nombre de participants prévus ne peut pas être négatif."

#. module: training_management_sale
#: code:addons/training_management_sale/models/crm_lead.py:0
msgid "The preferred end date must follow the start date."
msgstr "La date de fin souhaitée doit suivre la date de début."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order.py:0
msgid "Qualify the training request before confirming its order."
msgstr "Qualifiez la demande de formation avant de confirmer sa commande."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order.py:0
msgid "A training order requires a validated or published programme version."
msgstr "Une commande de formation exige une version de programme validée ou publiée."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order.py:0
msgid "Choose a pricelist in the requested currency before confirming."
msgstr "Choisissez une liste de prix dans la devise demandée avant de confirmer."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order.py:0
msgid "Training lines must use the requested programme version."
msgstr "Les lignes de formation doivent utiliser la version de programme demandée."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order.py:0
msgid "Revise the training offer instead of changing its confirmed request."
msgstr "Révisez l’offre de formation au lieu de modifier la demande confirmée."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order_line.py:0
msgid "A training product and programme version must be selected together."
msgstr "Le produit de formation et la version du programme doivent être choisis ensemble."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order_line.py:0
msgid "The programme must match the commercial product and company."
msgstr "Le programme doit correspondre au produit commercial et à la société."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order_line.py:0
msgid "Only validated or published programmes may be quoted."
msgstr "Seuls les programmes validés ou publiés peuvent être proposés sur un devis."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order_line.py:0
msgid "The programme version on a confirmed order is fixed."
msgstr "La version du programme d’une commande confirmée est figée."

#. module: training_management_sale
#: code:addons/training_management_sale/models/sale_order_line.py:0
msgid "The quoted programme reference is generated by the system."
msgstr "La référence du programme sur le devis est générée par le système."
