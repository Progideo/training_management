msgstr "Contacts autorisés sur le portail"

#. module: training_management_sale
#: model:ir.model.fields,help:training_management_sale.field_sale_order__training_portal_partner_ids
msgid ""
"Only these named contacts may view this training quotation or order in the "
"portal."
msgstr ""
"Seuls ces contacts nommément autorisés peuvent consulter ce devis ou cette "
"commande de formation sur le portail."

#. module: training_management_sale
#: model:ir.model.fields,help:training_management_sale.field_account_move__training_portal_partner_ids
#: model:ir.model.fields,help:training_management_sale.field_account_bank_statement_line__training_portal_partner_ids
msgid ""
"Only these named contacts may view this training invoice in the portal."
msgstr ""
"Seuls ces contacts nommément autorisés peuvent consulter cette facture de "
"formation sur le portail."

#. module: training_management_sale
#: model_terms:ir.ui.view,arch_db:training_management_sale.view_move_form_training_portal
msgid "Copy Contacts from Order"
msgstr "Reprendre les contacts de la commande"

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_move.py:0
msgid "Only a salesperson may copy authorized contacts from a training order."
msgstr ""
"Seul un commercial peut reprendre les contacts autorisés d’une commande de "
"formation."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_move.py:0
msgid "Copy authorized contacts only on a draft training invoice."
msgstr ""
"Reprenez les contacts autorisés uniquement sur une facture de formation en "
"brouillon."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_move.py:0
msgid "This invoice must be linked only to training orders of its company."
msgstr ""
"Cette facture doit être liée uniquement à des commandes de formation de sa "
"société."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_move.py:0
msgid "No contact is authorized on every linked training order."
msgstr ""
"Aucun contact n’est autorisé sur toutes les commandes de formation liées."

#. module: training_management_sale
#: model:ir.model.fields,field_description:training_management_sale.field_account_move__training_is_sale_invoice
#: model:ir.model.fields,field_description:training_management_sale.field_account_bank_statement_line__training_is_sale_invoice
msgid "Training Sales Invoice"
msgstr "Facture de vente de formation"

#. module: training_management_sale
#: model_terms:ir.ui.view,arch_db:training_management_sale.view_move_form_training_portal
msgid "Training Portal Access"
msgstr "Accès portail à la formation"

