msgid "Unverified"
msgstr "Non vérifié"

#. module: training_management_sale
#: model:ir.model.fields.selection,name:training_management_sale.selection__training_bank_transfer_notice__state__void
msgid "Voided"
msgstr "Annulé"

#. module: training_management_sale
#: model:ir.model.fields,field_description:training_management_sale.field_sale_order__training_transfer_notice_ids
msgid "Transfer Notices"
msgstr "Avis de virement"

#. module: training_management_sale
#: model_terms:ir.ui.view,arch_db:training_management_sale.view_sale_order_form_training
msgid "Unverified Transfer Notices"
msgstr "Avis de virement non vérifiés"

#. module: training_management_sale
#: model_terms:ir.ui.view,arch_db:training_management_sale.view_sale_order_form_training
msgid "Void"
msgstr "Annuler"

#. module: training_management_sale
#: model_terms:ir.ui.view,arch_db:training_management_sale.view_sale_order_form_training
msgid "An unverified notice does not reduce the invoice balance."
msgstr "Un avis non vérifié ne réduit pas le solde de la facture."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "A transfer notice requires a confirmed training order."
msgstr "Un avis de virement nécessite une commande de formation confirmée."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "The claimed transfer amount must be positive."
msgstr "Le montant du virement déclaré doit être positif."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "Enter the reference provided with the transfer notice."
msgstr "Saisissez la référence fournie avec l’avis de virement."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "The claimed invoice must belong to the order in its currency."
msgstr "La facture indiquée doit appartenir à la commande dans sa devise."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "A new transfer notice must be unverified."
msgstr "Un nouvel avis de virement doit être non vérifié."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "A transfer notice cannot be changed after reporting."
msgstr "Un avis de virement ne peut pas être modifié après sa déclaration."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/bank_transfer_notice.py:0
msgid "Only accounting staff can void a transfer notice."
msgstr "Seule la comptabilité peut annuler un avis de virement."

#. module: training_management_sale
#: model:ir.model.fields,field_description:training_management_sale.field_account_payment__training_bank_reference
#: model:ir.model.fields,field_description:training_management_sale.field_account_payment_register__training_bank_reference
msgid "Training Bank Reference"
msgstr "Référence bancaire de formation"

#. module: training_management_sale
#: model_terms:ir.ui.view,arch_db:training_management_sale.view_account_payment_register_form_training
msgid "Bank Transfer Reference"
msgstr "Référence du virement bancaire"

#. module: training_management_sale
#: model:ir.model.fields,field_description:training_management_sale.field_account_payment__training_duplicate_reference_reason
#: model:ir.model.fields,field_description:training_management_sale.field_account_payment_register__training_duplicate_reference_reason
msgid "Repeated Reference Reason"
msgstr "Motif de réutilisation de la référence"

#. module: training_management_sale
#: model:ir.model.fields,help:training_management_sale.field_account_payment__training_bank_reference
msgid ""
"Reference checked against the bank evidence, separate from the invoice memo."
msgstr ""
"Référence contrôlée sur la preuve bancaire, distincte du libellé de facture."

#. module: training_management_sale
#: model:ir.model.fields,help:training_management_sale.field_account_payment__training_duplicate_reference_reason
msgid ""
"Explain an intentional allocation of one transfer across several payments."
msgstr ""
"Expliquez la répartition volontaire d’un même virement entre plusieurs "
"paiements."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_payment.py:0
msgid "The bank reference of a posted payment cannot be changed."
msgstr ""
"La référence bancaire d’un paiement comptabilisé ne peut pas être modifiée."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_payment_register.py:0
#: code:addons/training_management_sale/models/account_payment.py:0
msgid ""
"This bank reference was already recorded in this company and journal. "
"Explain the intentional split before continuing."
msgstr ""
"Cette référence bancaire a déjà été enregistrée dans cette société et ce "
"journal. Expliquez la répartition volontaire avant de continuer."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_payment_register.py:0
msgid "Enter the bank reference before recording a training payment."
msgstr ""
"Saisissez la référence bancaire avant d’enregistrer un paiement de "
"formation."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_payment_register.py:0
msgid ""
"A training payment in another currency requires an explicit accounting "
"review."
msgstr ""
"Un paiement de formation dans une autre devise nécessite une revue comptable"
" explicite."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_payment_register.py:0
msgid ""
"Record training invoice payments through a bank journal with the manual "
"method."
msgstr ""
"Enregistrez les paiements des factures de formation dans un journal bancaire"
" avec la méthode manuelle."

#. module: training_management_sale
#. odoo-python
#: code:addons/training_management_sale/models/account_payment.py:0
msgid ""
"A training bank reference requires an incoming bank payment with the manual "
"method."
msgstr ""
"Une référence bancaire de formation exige un paiement entrant dans un "
"journal bancaire avec la méthode manuelle."

#. module: training_management_sale
#: model:ir.model.fields,field_description:training_management_sale.field_sale_order__training_portal_partner_ids
#: model:ir.model.fields,field_description:training_management_sale.field_account_move__training_portal_partner_ids
#: model:ir.model.fields,field_description:training_management_sale.field_account_bank_statement_line__training_portal_partner_ids
