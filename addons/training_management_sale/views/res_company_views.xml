<odoo>
    <record id="view_company_form_training_downpayment" model="ir.ui.view">
        <field name="name">res.company.form.training.downpayment</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="training_accounting" string="Training Accounting" groups="account.group_account_manager">
                    <group string="Sales Down Payments">
                        <field name="downpayment_account_id" options="{'no_create': True}"/>
                        <div colspan="2" class="text-muted">
                            This account applies to all sales down payment invoices for this company.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
