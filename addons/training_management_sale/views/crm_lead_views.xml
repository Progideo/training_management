<odoo>
    <record id="view_crm_lead_form_training" model="ir.ui.view">
        <field name="name">crm.lead.form.training</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_confirm_session_participants" type="object" string="Confirm Session Places"
                        groups="training_management.group_training_coordinator"
                        invisible="not training_requested_delivery_id or training_session_enrollment_ids" class="btn-primary"/>
                <button name="action_view_session_participants" type="object" string="Session Participants"
                        groups="training_management.group_training_coordinator"
                        invisible="not training_session_enrollment_ids"/>
                <field name="training_session_enrollment_ids" invisible="1" groups="training_management.group_training_coordinator"/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('d-flex', 'flex-column-reverse', 'flex-md-row')]" position="after">
                <group name="training_request" string="Training Request">
                    <group>
                        <field name="training_request_kind"/>
                        <field name="training_requested_course_id" invisible="not training_request_kind or not training_requested_course_id" readonly="1"/>
                        <field name="training_program_id" invisible="not training_request_kind" options="{'no_create': True}"/>
                        <field name="training_requested_delivery_id" invisible="not training_requested_delivery_id"/>
                        <field name="training_attendee_count" invisible="not training_request_kind"/>
                        <field name="training_requested_currency_id" invisible="not training_request_kind" options="{'no_create': True}"/>
                    </group>
                    <group invisible="not training_request_kind">
                        <field name="training_request_type"/><field name="training_objectives"/><field name="training_level"/><field name="training_country_id"/><field name="training_tools"/><field name="training_advice_requested"/>
                        <field name="training_delivery_mode"/>
                        <field name="training_date_from"/>
                        <field name="training_date_to"/>
                        <field name="training_sponsor_id" options="{'no_create': True}"/>
                        <field name="training_expected_payer_id" options="{'no_create': True}"/>
                        <field name="training_admin_contact_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
