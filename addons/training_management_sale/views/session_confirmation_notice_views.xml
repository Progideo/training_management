<odoo>
    <record id="view_session_confirmation_notice_list" model="ir.ui.view">
        <field name="name">training.session.confirmation.notice.list</field>
        <field name="model">training.session.confirmation.notice</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="email"/>
                <field name="is_requester"/>
                <field name="participant_ids" widget="many2many_tags"/>
                <field name="distribution_state"/>
            </list>
        </field>
    </record>
    <record id="view_session_confirmation_notice_form" model="ir.ui.view">
        <field name="name">training.session.confirmation.notice.form</field>
        <field name="model">training.session.confirmation.notice</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <group>
                    <field name="lead_id"/>
                    <field name="email"/>
                    <field name="is_requester"/>
                    <field name="participant_ids" widget="many2many_tags"/>
                    <field name="distribution_state"/>
                </group>
                <field name="details_html"/>
            </form>
        </field>
    </record>
    <record id="view_crm_lead_confirmation_email" model="ir.ui.view">
        <field name="name">crm.lead.session.confirmation.email</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="view_crm_lead_form_training"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_session_confirmation_emails" type="object" string="Confirmation Emails"
                        groups="training_management.group_training_coordinator"
                        invisible="not training_session_enrollment_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
