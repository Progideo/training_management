<odoo>
    <record id="view_account_payment_register_form_training" model="ir.ui.view">
        <field name="name">account.payment.register.form.training</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="attributes">
                <attribute name="name">communication</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_form_training" model="ir.ui.view">
        <field name="name">account.payment.form.training</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="training_bank_reference" readonly="1" invisible="not training_bank_reference"/>
                <field name="training_bank_verified" readonly="1" invisible="not training_bank_reference"/>
                <field name="training_bank_verified_by_id" invisible="not training_bank_verified"/>
                <field name="training_bank_verified_at" invisible="not training_bank_verified"/>
                <field name="training_duplicate_reference_reason" readonly="1" invisible="not training_bank_reference"/>
            </xpath>
        </field>
    </record>
</odoo>
