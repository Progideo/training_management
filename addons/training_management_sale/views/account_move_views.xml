<odoo>
    <record id="view_move_form_training_portal" model="ir.ui.view">
        <field name="name">account.move.form.training.portal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="training_invoice_portal" string="Training Portal Access"
                    invisible="not training_is_sale_invoice">
                    <field name="training_is_sale_invoice" invisible="1"/>
                    <field name="training_portal_partner_ids" widget="many2many_tags"
                        options="{'no_create': True}"/>
                    <button name="action_copy_training_portal_contacts" type="object"
                        string="Copy Contacts from Order" class="btn-secondary"
                        groups="sales_team.group_sale_salesman"
                        invisible="state != 'draft'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
