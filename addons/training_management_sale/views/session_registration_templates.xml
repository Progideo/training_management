<odoo>
    <template id="public_course_session_registration" inherit_id="training_catalog.public_course" priority="30">
        <xpath expr="//div[@id='training_booking_inter_actions']" position="inside">
            <form t-if="public_sessions" id="training_public_sessions" method="get" class="mb-0"
                  t-att-action="'/formations/catalogue/%s/inscription' % course['id']">
                <fieldset class="mb-3">
                    <legend class="o_training_course_legend">Choisissez votre session</legend>
                    <div t-foreach="public_sessions" t-as="session"
                         t-attf-class="form-check o_training_course_session #{'o_training_course_session_confirmed' if session['confirmed'] else ''}">
                        <input class="form-check-input" type="radio" name="session" t-att-id="'training_session_%s' % session['id']"
                               t-att-value="session['id']" t-att-disabled="not session['limit']" t-att-checked="session['id'] == selected_session"/>
                        <label class="form-check-label" t-att-for="'training_session_%s' % session['id']">
                            <span class="o_training_course_session_main">
                                <span t-if="session['confirmed']" class="badge text-bg-success mb-1">Session confirmée</span>
                                <strong class="d-block" t-out="session['dates']"/>
                                <span class="d-block small"><t t-out="session['mode']"/><t t-if="session['location']"> · <t t-out="session['location']"/></t><t t-if="session['hours']"> · <t t-out="session['hours']"/></t></span>
                            </span>
                            <span t-if="not session['limit']" class="o_training_course_seats">Session complète</span>
                            <span t-elif="session['few_seats']" class="o_training_course_seats o_training_course_seats_low">Plus que <t t-out="session['seats_left']"/> place(s)</span>
                            <span t-elif="session['seats_left']" class="o_training_course_seats o_training_course_seats_open"><t t-out="session['seats_left']"/> places</span>
                        </label>
                    </div>
                </fieldset>
                <button t-if="selected_session" type="submit" class="btn btn-primary btn-lg w-100">S’inscrire à cette session</button>
            </form>
        </xpath>
    </template>

    <template id="public_session_registration" name="Inter-company session request">
        <t t-call="portal.frontend_layout">
            <main id="wrap" class="container py-4 o_training_public_page o_not_editable">
                <p><a t-att-href="'/formations/catalogue/%s?format=inter#training_course_booking' % course_id">Retour à la fiche formation</a></p>
                <h1>Demander une inscription inter-entreprises</h1>
                <p class="fw-semibold" t-out="title"/>
                <p><span t-if="session['confirmed']" class="badge text-bg-success me-2">Session confirmée</span><t t-out="session['dates']"/> · <t t-out="session['mode']"/><t t-if="session['location']"> · <t t-out="session['location']"/></t><t t-if="session['hours']"> · <t t-out="session['hours']"/></t></p>
                <p>L’équipe vous recontactera pour confirmer les places et les conditions d’inscription.</p>
                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <form t-if="session['limit']" method="post" t-att-action="session['url']" class="col-md-8 col-lg-6">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="submission_token" t-att-value="token"/>
                    <div class="mb-3">
                        <label class="form-label" for="contact">Votre nom</label>
                        <input class="form-control" id="contact" name="contact" autocomplete="name" maxlength="254" required="required" t-att-value="values['contact']"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="email">Votre adresse email</label>
                        <input class="form-control" id="email" name="email" type="email" autocomplete="email" maxlength="254" required="required" t-att-value="values['email']"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="phone">Téléphone (facultatif)</label>
                        <input class="form-control" id="phone" name="phone" type="tel" autocomplete="tel" maxlength="254" t-att-value="values['phone']"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="organisation">Entreprise (facultatif)</label>
                        <input class="form-control" id="organisation" name="organisation" autocomplete="organization" maxlength="254" t-att-value="values['organisation']"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="count">Nombre de participants</label>
                        <select class="form-select" id="count" name="count" required="required">
                            <option t-foreach="range(1, session['limit'] + 1)" t-as="count" t-att-value="count" t-att-selected="str(count) == values['count']" t-out="count"/>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Envoyer la demande d’inscription</button>
                </form>
            </main>
        </t>
    </template>
</odoo>
