<odoo noupdate="1">
    <record id="mail_template_session_confirmation" model="mail.template">
        <field name="name">Confirmation d’inscription à une session</field>
        <field name="model_id" ref="model_training_session_confirmation_notice"/>
        <field name="subject">Confirmation d’inscription — {{ object.lead_id.training_requested_course_id.name }}</field>
        <field name="lang">{{ object.recipient_language }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div>
                <p>Bonjour,</p>
                <p t-if="object.is_requester">
                    Nous confirmons les <t t-out="object.lead_id.training_attendee_count"/> place(s)
                    demandée(s) pour la formation ci-dessous.
                </p>
                <p t-else="">Votre inscription à la formation ci-dessous est confirmée.</p>
                <p t-if="object.participant_ids">
                    Participant(s) destinataire(s) de ce message
                    <t t-out="', '.join(object.participant_ids.mapped('name'))"/>.
                </p>
                <t t-out="object.details_html"/>
                <p>Pour toute question, vous pouvez répondre à ce message.</p>
                <p t-out="object.company_id.name"/>
            </div>
        </field>
    </record>
</odoo>
