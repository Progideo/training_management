<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_training_progress" name="My Progress">
        <t t-call="portal.portal_layout" additional_title.translate="My progress">
            <h1>My progress</h1>
            <p class="text-muted">Points reward your engagement in training. They never open an access and do not appear on your certificates.</p>
            <div t-if="saved" role="status" class="alert alert-success">Your choice has been saved.</div>
            <section class="row g-3 my-3">
                <div class="col-sm-4"><div class="card p-3 h-100">
                    <div class="text-muted">Points</div>
                    <div class="fs-2 fw-bold" t-out="karma"/>
                </div></div>
                <div class="col-sm-8"><div class="card p-3 h-100">
                    <div class="text-muted">Rank</div>
                    <div class="fs-4 fw-bold" t-out="rank or '—'"/>
                    <div t-if="next_rank"><t t-out="to_next_rank"/> points to reach <strong t-out="next_rank"/></div>
                </div></div>
            </section>
            <section class="my-4">
                <h2>My badges</h2>
                <p t-if="not badges">No badge yet.</p>
                <ul t-else="" class="list-unstyled d-flex flex-wrap gap-3">
                    <li t-foreach="badges" t-as="badge" class="text-center" style="width: 7rem;">
                        <img t-att-src="'/my/training-progress/badge/%s' % badge['id']" alt="" width="64" height="64" class="object-fit-contain"/>
                        <div class="small fw-bold" t-out="badge['name']"/>
                        <div class="small text-muted" t-out="badge['date']" t-options="{'widget': 'date'}"/>
                    </li>
                </ul>
            </section>
            <section class="my-4">
                <h2>My challenges</h2>
                <p t-if="not goals">No challenge in progress.</p>
                <ul t-else="" class="list-group">
                    <li t-foreach="goals" t-as="goal" class="list-group-item">
                        <div class="fw-bold" t-out="goal['challenge']"/>
                        <div><t t-out="goal['goal']"/> : <t t-out="goal['current']"/> / <t t-out="goal['target']"/>
                            <span t-if="goal['reached']" class="badge text-bg-success ms-2">Reached</span></div>
                    </li>
                </ul>
            </section>
            <section class="my-4">
                <h2>Latest points</h2>
                <p t-if="not points">No points yet.</p>
                <div t-else="" class="table-responsive"><table class="table table-sm">
                    <thead><tr><th>Date</th><th>Reason</th><th>Training</th><th class="text-end">Points</th></tr></thead>
                    <tbody><tr t-foreach="points" t-as="line">
                        <td t-out="line['date']" t-options="{'widget': 'date'}"/>
                        <td t-out="line['rule']"/>
                        <td t-out="line['training'] or ''"/>
                        <td class="text-end" t-out="'%+d' % line['points']"/>
                    </tr></tbody>
                </table></div>
            </section>
            <section t-if="can_publish" class="my-4">
                <h2>My public profile</h2>
                <p t-if="published">Your profile, with your points, rank and badges, is public. It appears in the ranking of published profiles.</p>
                <p t-else="">Your profile is private: nobody else sees your points, rank or badges.</p>
                <form method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button t-if="published" type="submit" name="operation" value="unpublish" class="btn btn-outline-secondary">Make my profile private</button>
                    <button t-else="" type="submit" name="operation" value="publish" class="btn btn-outline-primary">Publish my profile</button>
                </form>
            </section>
        </t>
    </template>

    <template id="portal_progress_home" inherit_id="portal.portal_my_home" name="My Training Progress">
        <!-- Kept for updates: « My points and badges » is now a « My account » card. -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><t/></xpath>
    </template>

    <template id="portal_progress_link" inherit_id="training_management.portal_trainings">
        <xpath expr="//h1" position="after"><t/></xpath>
    </template>

    <template id="company_training_engagement" inherit_id="training_management.company_training" name="Collective Engagement">
        <xpath expr="//div[hasclass('card')][1]" position="after">
            <t t-set="engagement" t-value="request.env['training.gamification.service']._client_indicator(allocation_id)"/>
            <section t-if="engagement" class="card p-3 mb-3" id="company-engagement">
                <h2 class="h5">Collective engagement</h2>
                <p><strong><t t-out="engagement['active']"/> %</strong> of your <t t-out="engagement['participants']"/> participants earned engagement points.</p>
                <p t-if="engagement['challenges'] is not False"><strong><t t-out="engagement['challenges']"/> %</strong> reached a session challenge.</p>
                <p class="small text-muted mb-0">Collective figures only, shown from three participants.</p>
            </section>
        </xpath>
    </template>
</odoo>
